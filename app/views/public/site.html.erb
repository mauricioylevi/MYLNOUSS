<div style="margin-bottom: 3rem; text-align: center;">
  <h1 style="font-size: 2.5rem; font-weight: 800; margin-bottom: 1rem; color: var(--color-text-main);">Public Gallery</h1>
  <p style="font-size: 1.1rem; color: var(--color-text-muted); max-width: 600px; margin: 0 auto;">
    Welcome to the public-facing side of MYLNOUSS. Here are the photos that have been successfully published from the dashboard.
  </p>
</div>

<% if @photos.empty? %>
  <div style="text-align: center; padding: 4rem; background: var(--color-surface); border-radius: 16px; border: 1px dashed #cbd5e1;">
    <span style="font-size: 3rem;">📸</span>
    <h3 style="margin-top: 1rem; color: var(--color-text-main);">No Photos Yet</h3>
    <p style="color: var(--color-text-muted);">Go to the Dashboard to upload and publish some photos!</p>
  </div>
<% else %>
  <div style="display: grid; grid-template-columns: repeat(auto-fill, minmax(300px, 1fr)); gap: 2rem;">
    <% @photos.each do |photo| %>
      <div style="background: var(--color-surface); border-radius: 12px; overflow: hidden; box-shadow: 0 4px 6px -1px rgba(0, 0, 0, 0.1), 0 2px 4px -1px rgba(0, 0, 0, 0.06); transition: transform 0.2s ease;" onmouseover="this.style.transform='translateY(-4px)'" onmouseout="this.style.transform='translateY(0)'">
        <% if photo.image.attached? %>
          <img src="<%= url_for(photo.image) %>" alt="Gallery Photo" style="width: 100%; height: 250px; object-fit: cover; display: block;">
        <% else %>
          <div style="width: 100%; height: 250px; background: #e2e8f0; display: flex; align-items: center; justify-content: center; color: var(--color-text-muted);">
            No Image
          </div>
        <% end %>
        <div style="padding: 1.5rem;">
          <p style="margin: 0; font-size: 1.1rem; line-height: 1.5; font-weight: 500; color: var(--color-text-main);">
            <%= photo.description.present? ? photo.description : "No description provided." %>
          </p>
          <div style="margin-top: 1rem; font-size: 0.85rem; color: var(--color-text-muted);">
            Published <%= time_ago_in_words(photo.updated_at) %> ago
          </div>
        </div>
      </div>
    <% end %>
  </div>
<% end %>
