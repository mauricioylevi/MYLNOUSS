<main class="app-content">
<div style="max-width: 1100px; margin: 0 auto; padding: 2rem 1rem; width: 100%;">
  
  <!-- Header -->
  <div style="margin-bottom: 2rem; display: flex; justify-content: space-between; align-items: center; flex-wrap: wrap; gap: 1rem;">
    <div>
      <div style="display: flex; align-items: center; gap: 0.75rem;">
        <span style="font-size: 2.2rem; background: #dcfce7; padding: 0.4rem 0.6rem; border-radius: 12px; border: 2px solid #000000; box-shadow: 2px 2px 0px #000000;">🔑</span>
        <div>
          <h1 style="font-size: 2.2rem; font-weight: 900; color: #000000; margin: 0; letter-spacing: -0.5px;">Main User Access</h1>
          <p style="font-size: 1.05rem; color: var(--color-text-muted); margin: 0.25rem 0 0 0; font-weight: 600;">
            Manage direct login credentials, access tokens, and portal security for the Main User
          </p>
        </div>
      </div>
    </div>

    <a href="/" class="btn btn-outline" style="border-radius: 50px; padding: 0.5rem 1.25rem; font-size: 0.9rem; font-weight: 700; border: 2px solid #000000; box-shadow: 2px 2px 0px #000000;">
      &larr; Back to Dashboard
    </a>
  </div>

  <% if notice.present? %>
    <div style="background: #dcfce7; color: #065f46; border: 2px solid #000000; padding: 1rem 1.5rem; border-radius: 10px; margin-bottom: 2rem; font-weight: 700; box-shadow: 3px 3px 0px #000000;">
      <%= notice %>
    </div>
  <% end %>

  <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(360px, 1fr)); gap: 2rem;">
    
    <!-- Token Management Card -->
    <div style="background: #ffffff; border-radius: 14px; border: 2px solid #000000; padding: 2rem; box-shadow: var(--shadow-relief-md); display: flex; flex-direction: column; justify-content: space-between;">
      <div>
        <div style="display: flex; align-items: center; gap: 0.6rem; margin-bottom: 1rem; border-bottom: 2px solid #f1f5f9; padding-bottom: 0.75rem;">
          <span style="font-size: 1.4rem;">🛡️</span>
          <h3 style="margin: 0; font-size: 1.35rem; font-weight: 900; color: #000000;">Access Token Setup</h3>
        </div>
        
        <p style="color: #475569; font-size: 0.95rem; font-weight: 600; line-height: 1.5; margin-bottom: 1.5rem;">
          Generate a secure, persistent access token to allow the Main User to log in directly on their personal tablet, computer, or dedicated screen.
        </p>

        <div style="background: #f8fafc; border: 2px solid #000000; padding: 1.25rem; border-radius: 10px; margin-bottom: 1.5rem; box-shadow: 2px 2px 0px #000000;">
          <div style="font-size: 0.85rem; font-weight: 800; text-transform: uppercase; color: #64748b; margin-bottom: 0.4rem;">
            Current Access Token:
          </div>
          
          <% if @main_user&.access_token.present? %>
            <div style="display: flex; align-items: center; gap: 0.5rem; flex-wrap: wrap;">
              <code style="background: #ffffff; border: 1.5px solid #000000; padding: 0.45rem 0.85rem; border-radius: 6px; color: #0f172a; font-weight: 700; font-size: 1rem; word-break: break-all; flex: 1;">
                <%= @main_user.access_token %>
              </code>
              <button onclick="navigator.clipboard.writeText('<%= @main_user.access_token %>'); alert('Access token copied to clipboard!');" class="btn btn-outline" style="border-radius: 6px; padding: 0.45rem 0.85rem; font-size: 0.85rem; font-weight: 700; border: 1.5px solid #000000;">
                📋 Copy
              </button>
            </div>
            <div style="font-size: 0.8rem; color: #059669; font-weight: 700; margin-top: 0.6rem;">
              ● Token is active and ready for use
            </div>
          <% else %>
            <div style="color: #94a3b8; font-style: italic; font-weight: 600; padding: 0.5rem 0;">
              No token generated yet. Click below to generate one.
            </div>
          <% end %>
        </div>
      </div>

      <div style="display: flex; gap: 0.75rem; flex-wrap: wrap;">
        <%= button_to (@main_user&.access_token.present? ? "🔄 Regenerate Token" : "✨ Generate Access Token"), 
                      main_user_access_generate_token_path, 
                      method: :post, 
                      class: "btn btn-primary", 
                      style: "border-radius: 50px; font-weight: 800; font-size: 0.95rem; padding: 0.65rem 1.5rem; border: 2px solid #000000; box-shadow: 2px 2px 0px #000000;" %>
        
        <% if @main_user&.access_token.present? %>
          <%= button_to "Revoke Token", 
                        main_user_access_revoke_token_path, 
                        method: :post, 
                        data: { confirm: "Are you sure you want to revoke the Main User's active access token?" }, 
                        class: "btn btn-outline", 
                        style: "border-radius: 50px; font-weight: 700; font-size: 0.9rem; padding: 0.65rem 1.25rem; border: 2px solid #000000; background: #fee2e2; color: #991b1b; box-shadow: 2px 2px 0px #000000;" %>
        <% end %>
      </div>
    </div>

    <!-- Independent Login & Kiosk Guide Card -->
    <div style="background: #ffffff; border-radius: 14px; border: 2px solid #000000; padding: 2rem; box-shadow: var(--shadow-relief-md); display: flex; flex-direction: column; justify-content: space-between;">
      <div>
        <div style="display: flex; align-items: center; gap: 0.6rem; margin-bottom: 1rem; border-bottom: 2px solid #f1f5f9; padding-bottom: 0.75rem;">
          <span style="font-size: 1.4rem;">📱</span>
          <h3 style="margin: 0; font-size: 1.35rem; font-weight: 900; color: #000000;">Kiosk Mode &amp; Independent Access</h3>
        </div>
        
        <p style="color: #475569; font-size: 0.95rem; font-weight: 600; line-height: 1.5; margin-bottom: 1.25rem;">
          The Main User can interact with cognitive games and photo albums without navigating complex caregiver settings.
        </p>

        <div style="display: flex; flex-direction: column; gap: 0.75rem; margin-bottom: 1.5rem;">
          <div style="background: #ede9fe; border: 1.5px solid #000000; border-radius: 8px; padding: 0.85rem 1rem;">
            <div style="font-weight: 800; font-size: 0.9rem; color: #5b21b6; margin-bottom: 0.2rem;">
              🎮 Simplified Games &amp; Albums
            </div>
            <div style="font-size: 0.85rem; color: #1e293b; font-weight: 600;">
              High-contrast, senior-accessible UI designed for cognitive stimulation without distraction.
            </div>
          </div>

          <div style="background: #ccfbf1; border: 1.5px solid #000000; border-radius: 8px; padding: 0.85rem 1rem;">
            <div style="font-weight: 800; font-size: 0.9rem; color: #0f766e; margin-bottom: 0.2rem;">
              🔒 Protected Caregiver Settings
            </div>
            <div style="font-size: 0.85rem; color: #1e293b; font-weight: 600;">
              Administration, questionnaires, and account controls remain securely locked for the Primary Caregiver.
            </div>
          </div>
        </div>
      </div>

      <div style="background: #f8fafc; border: 1.5px solid #94a3b8; border-radius: 8px; padding: 0.75rem 1rem; font-size: 0.85rem; color: #475569; font-weight: 600;">
        💡 <strong>Caregiver Tip:</strong> Set up a bookmark or home-screen shortcut on the Main User's device using their direct link for one-tap daily access.
      </div>
    </div>

  </div>

</div>
</main>
