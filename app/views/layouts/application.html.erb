<!DOCTYPE html>
<html>
  <head>
    <title><%= content_for(:title) || "Mylnouss Core" %></title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <meta name="apple-mobile-web-app-capable" content="yes">
    <meta name="application-name" content="Mylnouss Core">
    <meta name="mobile-web-app-capable" content="yes">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>

    <%= yield :head %>

    <%# Enable PWA manifest for installable apps (make sure to enable in config/routes.rb too!) %>
    <%#= tag.link rel: "manifest", href: pwa_manifest_path(format: :json) %>

    <link rel="icon" href="/icon.png" type="image/png">
    <link rel="icon" href="/icon.svg" type="image/svg+xml">
    <link rel="apple-touch-icon" href="/icon.png">

    <%# Includes all stylesheet files in app/assets/stylesheets %>
    <%= stylesheet_link_tag :app, "data-turbo-track": "reload" %>
    <%= javascript_importmap_tags %>
  </head>

  <body class="dashboard-body theme-category-<%= current_category_theme %>" data-theme-category="<%= current_category_theme %>">
    

    <!-- Top Navigation -->
        <nav class="app-navbar">
            <div class="navbar-brand">
                <span style="color: var(--color-primary); font-size: 1.4rem;">🍃</span>
                MYLNOUSS
            </div>
        </nav>

    <div class="app-shell theme-category-<%= current_category_theme %>" data-theme-category="<%= current_category_theme %>">
            <!-- Left Sidebar -->
            <aside class="app-sidebar">
                
                <!-- Personal & Family (Green Accent) -->
                <div class="sidebar-block sidebar-block--green">
                    <div class="sidebar-block-title">
                        <span>🌿</span> Personal & Family
                    </div>
                    <ul class="sidebar-menu">
                        <li>
                            <a href="/profile" class="sidebar-link <%= 'active' if current_page?('/profile') %>">
                                <div class="link-icon-box">👤</div>
                                <div class="link-text-group">
                                    <span class="link-title">About Me & Details</span>
                                    <span class="link-subtitle">My story & preferences</span>
                                </div>
                            </a>
                        </li>
                        <li>
                            <a href="/photos" class="sidebar-link <%= 'active' if controller_name == 'photos' %>">
                                <div class="link-icon-box">📸</div>
                                <div class="link-text-group">
                                    <span class="link-title">My Photo Album</span>
                                    <span class="link-subtitle">Favorite family pictures & stories</span>
                                </div>
                            </a>
                        </li>
                        <li>
                            <a href="/main_user_access" class="sidebar-link <%= 'active' if controller_name == 'main_user_access' %>">
                                <div class="link-icon-box">🔑</div>
                                <div class="link-text-group">
                                    <span class="link-title">Main User Access</span>
                                    <span class="link-subtitle">Direct login token & kiosk setup</span>
                                </div>
                            </a>
                        </li>
                        <li>
                            <a href="<%= guests_path %>" class="sidebar-link <%= 'active' if controller_name == 'guests' %>">
                                <div class="link-icon-box">👥</div>
                                <div class="link-text-group">
                                    <span class="link-title">Family & Loved Ones</span>
                                    <span class="link-subtitle">Invite family members & helpers</span>
                                </div>
                            </a>
                        </li>
                    </ul>
                </div>

                <!-- Daily Journal (Blue Accent) -->
                <div class="sidebar-block sidebar-block--blue">
                    <div class="sidebar-block-title">
                        <span>📓</span> My Daily Journal
                    </div>
                    <ul class="sidebar-menu">
                        <li>
                            <a href="<%= today_daily_journals_path %>" class="sidebar-link <%= 'active' if controller_name == 'daily_journals' && action_name == 'today' %>">
                                <div class="link-icon-box">✍️</div>
                                <div class="link-text-group">
                                    <span class="link-title">Today's Journal</span>
                                    <span class="link-subtitle">Write or speak today's thoughts</span>
                                </div>
                            </a>
                        </li>
                        <li>
                            <a href="<%= daily_journals_path %>" class="sidebar-link <%= 'active' if controller_name == 'daily_journals' && (action_name == 'index' || action_name == 'show') %>">
                                <div class="link-icon-box">📖</div>
                                <div class="link-text-group">
                                    <span class="link-title">Past Memories & Journal</span>
                                    <span class="link-subtitle">Look back at cherished memories</span>
                                </div>
                            </a>
                        </li>
                    </ul>
                </div>

                <!-- Fun Brain Games (Purple Accent) -->
                <div class="sidebar-block sidebar-block--purple">
                    <div class="sidebar-block-title">
                        <span>🧩</span> Fun Brain Games
                    </div>
                    <ul class="sidebar-menu">
                        <li>
                            <a href="#" class="sidebar-link" onclick="toggleSidebarDropdown(event, 'games-dropdown', 'games-arrow')">
                                <div class="link-icon-box">🎮</div>
                                <div class="link-text-group">
                                    <span class="link-title">Choose a Game</span>
                                    <span class="link-subtitle">13 relaxing & engaging activities</span>
                                </div>
                                <span class="dropdown-arrow" id="games-arrow">▼</span>
                            </a>
                            <div class="sidebar-dropdown <%= 'open' if controller_name == 'games' %>" id="games-dropdown" style="<%= 'display: flex;' if controller_name == 'games' %>">
                                
                                <div class="sidebar-dropdown-group-header"><span>🖼️</span> Photo & Story Fun</div>
                                <a href="/games/story_sequence" class="sidebar-dropdown-link <%= 'active' if action_name == 'story_sequence' %>">
                                    <span>🎬</span> Story Sequence
                                </a>
                                <a href="/games/gallery" class="sidebar-dropdown-link <%= 'active' if action_name == 'gallery' %>">
                                    <span>🖼️</span> Photo Album Gallery
                                </a>
                                <a href="/games/photo_memory" class="sidebar-dropdown-link <%= 'active' if action_name == 'photo_memory' %>">
                                    <span>🧠</span> Remember That Picture
                                </a>
                                <a href="/games/career_quiz" class="sidebar-dropdown-link <%= 'active' if action_name == 'career_quiz' %>">
                                    <span>🎓</span> Life & Career Trivia
                                </a>
                                <a href="#" class="sidebar-dropdown-link" onclick="openProfileQuizModal(event)">
                                    <span>❓</span> Picture Quiz
                                </a>

                                <div class="sidebar-dropdown-group-header"><span>🔤</span> Words & Matching</div>
                                <a href="#" class="sidebar-dropdown-link" onclick="openCardsMatchModal(event)">
                                    <span>🃏</span> Match the Cards
                                </a>
                                <a href="/games/crossword" class="sidebar-dropdown-link <%= 'active' if action_name == 'crossword' %>">
                                    <span>✏️</span> Crossword Puzzle
                                </a>
                                <a href="/games/missing_word" class="sidebar-dropdown-link <%= 'active' if action_name == 'missing_word' %>">
                                    <span>🔍</span> Fill Missing Word
                                </a>
                                <a href="/games/word_search" class="sidebar-dropdown-link <%= 'active' if action_name == 'word_search' %>">
                                    <span>🔠</span> Word Search
                                </a>

                                <div class="sidebar-dropdown-group-header"><span>💬</span> Conversation & Joy</div>
                                <a href="/games/create_a_story" class="sidebar-dropdown-link <%= 'active' if action_name == 'create_a_story' %>">
                                    <span>📖</span> Create a Story
                                </a>
                                <a href="/games/critical_thinking" class="sidebar-dropdown-link <%= 'active' if action_name == 'critical_thinking' %>">
                                    <span>💡</span> Daily Brain Stretch
                                </a>
                                <a href="/games/lets_talk" class="sidebar-dropdown-link <%= 'active' if action_name == 'lets_talk' %>">
                                    <span>💬</span> Let's Talk!
                                </a>
                                <a href="/games/tic_tac_toe" class="sidebar-dropdown-link <%= 'active' if action_name == 'tic_tac_toe' %>">
                                    <span>⭕</span> Tic-Tac-Toe
                                </a>
                            </div>
                        </li>
                    </ul>
                </div>

                <!-- Care & Activity Reports (Teal Accent) -->
                <div class="sidebar-block sidebar-block--teal">
                    <div class="sidebar-block-title">
                        <span>📊</span> Care & Activity Reports
                    </div>
                    <ul class="sidebar-menu">
                        <li>
                            <a href="<%= reports_guest_access_path %>" class="sidebar-link <%= 'active' if controller_name == 'reports' && action_name == 'guest_access' %>">
                                <div class="link-icon-box">📊</div>
                                <div class="link-text-group">
                                    <span class="link-title">Family Visits & Activity</span>
                                    <span class="link-subtitle">Visits and shared photos</span>
                                </div>
                            </a>
                        </li>
                        <li>
                            <a href="<%= reports_wellness_path %>" class="sidebar-link <%= 'active' if controller_name == 'reports' && action_name == 'wellness' %>">
                                <div class="link-icon-box">📈</div>
                                <div class="link-text-group">
                                    <span class="link-title">Activity & Wellness</span>
                                    <span class="link-subtitle">Games played & journal streaks</span>
                                </div>
                            </a>
                        </li>
                        <li>
                            <a href="<%= reports_log_report_path %>" class="sidebar-link <%= 'active' if controller_name == 'reports' && action_name == 'log_report' %>">
                                <div class="link-icon-box">📅</div>
                                <div class="link-text-group">
                                    <span class="link-title">Safety & Activity Log</span>
                                    <span class="link-subtitle">App access and security records</span>
                                </div>
                            </a>
                        </li>
                    </ul>
                </div>

                <!-- Footer Profile -->
                <div class="sidebar-footer">
                    Active Session:<br>
                    <strong>admin@mylnouss.local</strong>
                    <span class="sidebar-role-badge">Super Admin</span>
                </div>
            </aside>

            <!-- Center Content Area -->
            
          <%= yield %>


        <!-- Premium Dark Footer -->

    </div>

    <% @main_user = MainUser.first %>
    <script id="backend-profile-data" type="application/json">
        <%= raw(@main_user&.profile_data&.to_json || '{}') %>
    </script>
    




    <!-- Photo Lightbox Modal (TTS Viewer) -->
    <div class="modal-overlay" id="photo-lightbox-modal" style="z-index: 9999; background: rgba(0, 0, 0, 0.9);">
        <div style="position: relative; width: 100%; height: 100%; display: flex; flex-direction: column; align-items: center; justify-content: center; padding: 2rem;">
            <button class="close-modal-btn" onclick="closeLightbox()" style="position: absolute; top: 2rem; right: 2rem; color: white; background: rgba(255,255,255,0.1); border-radius: 50%; width: 48px; height: 48px; font-size: 2rem; border: none; cursor: pointer; transition: background 0.3s;">&times;</button>
            <div style="max-width: 900px; width: 100%; max-height: 70vh; display: flex; align-items: center; justify-content: center; margin-bottom: 2rem;">
                <img id="lightbox-image" src="" alt="Photo Viewer" style="max-width: 100%; max-height: 70vh; object-fit: contain; border-radius: 12px; box-shadow: 0 25px 50px -12px rgba(0,0,0,0.5);">
            </div>
            <div style="max-width: 800px; width: 100%; text-align: center;">
                <div style="display: inline-flex; align-items: center; gap: 0.75rem; background: var(--color-primary); color: white; padding: 0.5rem 1.5rem; border-radius: 50px; font-weight: 600; font-size: 0.9rem; margin-bottom: 1rem; box-shadow: 0 4px 6px -1px rgba(16, 185, 129, 0.4);">
                    <span style="font-size: 1.2rem;">🔊</span> Reading Message...
                </div>
                <p id="lightbox-description" style="color: white; font-size: 1.5rem; line-height: 1.6; font-weight: 500; text-shadow: 0 2px 4px rgba(0,0,0,0.5);"></p>
            </div>
        </div>
    </div>

    <!-- Picturez Quiz Modal -->
    <div class="modal-overlay" id="profile-quiz-modal" style="z-index: 9998; background: rgba(0, 0, 0, 0.7);">
        <div class="modal-content" style="max-width: 800px; width: 95%; min-height: 600px; display: flex; flex-direction: column; background: var(--color-bg); border-radius: 16px; overflow: hidden; box-shadow: 0 20px 40px rgba(0,0,0,0.3);">
            <div class="modal-header" style="background: white; border-bottom: 1px solid var(--color-border); padding: 1.5rem 2rem; display: flex; justify-content: space-between; align-items: center;">
                <h2 style="margin: 0; font-size: 1.5rem; color: var(--color-text-main);">🎮 Picturez Quiz</h2>
            </div>
            <div class="modal-body" id="quiz-body" style="flex: 1; display: flex; flex-direction: column; justify-content: center; align-items: center; padding: 2rem; text-align: center;">
                
                <div id="quiz-loading-state" style="display: flex; flex-direction: column; align-items: center; justify-content: center; height: 100%;">
                    <div style="font-size: 3rem; animation: spin 2s linear infinite;">⌛</div>
                    <h3 style="margin-top: 1.5rem; color: var(--color-text-main);">Generating personalized AI game...</h3>
                    <p style="color: var(--color-text-muted);">Crafting images based on your profile hobbies.</p>
                </div>
                
                <div id="quiz-game-state" style="display: none; width: 100%; max-width: 600px; flex-direction: column; align-items: center;">
                    <h3 id="quiz-progress" style="color: var(--color-primary); margin-bottom: 1.5rem; font-size: 1.2rem;">Round 1 of 5</h3>
                    <img id="quiz-image" src="" style="width: 100%; max-height: 300px; object-fit: contain; border-radius: 12px; box-shadow: var(--shadow-md); margin-bottom: 2rem;">
                    <div id="quiz-choices" style="display: grid; grid-template-columns: 1fr; gap: 1rem; width: 100%;">
                        <!-- Buttons injected via JS -->
                    </div>
                </div>

                <div id="quiz-end-state" style="display: none; width: 100%; text-align: center;">
                    <div style="font-size: 5rem; margin-bottom: 1rem;">🏆</div>
                    <h2 style="color: var(--color-text-main); margin-bottom: 0.5rem;">Game Complete!</h2>
                    <p style="font-size: 1.2rem; color: var(--color-text-muted); margin-bottom: 2rem;">You successfully identified all 5 pictures!</p>
                    <div style="display: flex; justify-content: center; gap: 1rem;">
                        <button class="btn btn-outline" style="padding: 0.75rem 2rem; border-radius: 50px; font-size: 1.1rem;" onclick="closeProfileQuizModal(event)">Close</button>
                        <button class="btn btn-primary" style="padding: 0.75rem 2rem; border-radius: 50px; font-size: 1.1rem; box-shadow: 0 4px 15px rgba(99, 102, 241, 0.4);" onclick="startProfileQuiz()">Play Again</button>
                    </div>
                </div>
            </div>
        </div>
    </div>
    
    <style>
        @keyframes spin { 100% { transform: rotate(360deg); } }
        .quiz-btn {
            background: var(--color-surface);
            border: 2px solid var(--color-border);
            border-radius: 12px;
            padding: 1rem;
            font-size: 1.2rem;
            font-weight: 600;
            color: var(--color-text-main);
            cursor: pointer;
            transition: all 0.2s;
            text-align: center;
        }
        .quiz-btn:hover:not(:disabled) {
            border-color: var(--color-primary);
            background: rgba(99, 102, 241, 0.1);
        }
        .quiz-btn.correct {
            background: #e6f4ea !important;
            border-color: #34a853 !important;
            color: #137333 !important;
        }
        .quiz-btn.wrong {
            background: #fce8e6 !important;
            border-color: #ea4335 !important;
            color: #c5221f !important;
        }
    </style>

    <!-- Cards Match Modal -->
    <div class="modal-overlay" id="cards-match-modal" style="z-index: 9998; background: rgba(0, 0, 0, 0.7); display: none; align-items: center; justify-content: center;">
        <div id="cards-match-modal-content" class="modal-content" style="max-width: 800px; width: 95%; max-height: 90vh; display: flex; flex-direction: column; background: #ffffff; border-radius: 14px; overflow: hidden; border: 2px solid #000000; box-shadow: var(--shadow-relief-lg); transition: max-width 0.3s ease;">
            
            <div class="modal-header" style="background: #ffffff; border-bottom: 2px solid #000000; padding: 0.75rem 1.5rem; display: flex; justify-content: space-between; align-items: center;">
                <div style="display: flex; align-items: center; gap: 0.5rem;">
                    <span style="font-size: 1.5rem; background: #ede9fe; padding: 0.2rem 0.4rem; border-radius: 6px; border: 1.5px solid #000000;">🎴</span>
                    <h2 style="font-size: 1.25rem; font-weight: 900; color: #000000; margin: 0;">
                        Cards Match
                    </h2>
                </div>
                <button class="btn btn-outline btn-compact" onclick="closeCardsMatchModal()" style="border-radius: 50px; font-weight: 800; border: 1.5px solid #000000;" title="Close Game">✕ Close</button>
            </div>

            <!-- Game Screen (Top Aligned) -->
            <div id="cards-match-game-screen" class="modal-body" style="padding: 1rem 1.5rem; flex-grow: 1; display: none; flex-direction: column; background: #ffffff; align-items: center; overflow-y: auto;">
                <div style="width: 100%; display: flex; justify-content: space-between; align-items: center; margin-bottom: 1rem;">
                    <div style="display: flex; gap: 0.35rem; background: #f8fafc; padding: 0.2rem; border-radius: 50px; border: 1.5px solid #000000;">
                        <button id="cm-btn-easy" class="btn btn-compact" onclick="startCardsMatch('easy')" style="padding: 0.3rem 0.85rem; border-radius: 50px; font-weight: 800; font-size: 0.82rem;">Easy</button>
                        <button id="cm-btn-medium" class="btn btn-outline btn-compact" onclick="startCardsMatch('medium')" style="padding: 0.3rem 0.85rem; border-radius: 50px; border: none; font-weight: 800; font-size: 0.82rem;">Medium</button>
                        <button id="cm-btn-hard" class="btn btn-outline btn-compact" onclick="startCardsMatch('hard')" style="padding: 0.3rem 0.85rem; border-radius: 50px; border: none; font-weight: 800; font-size: 0.82rem;">Hard</button>
                    </div>

                    <span id="cards-match-stats" style="font-size: 1rem; font-weight: 800; color: #5b21b6; background: #ede9fe; border: 1px solid #000000; padding: 0.25rem 0.85rem; border-radius: 50px;">Matches: 0 / 4</span>
                </div>
                
                <div id="cards-match-board" style="display: grid; gap: 0.75rem; width: 100%; max-width: 750px; margin: 0 auto; perspective: 1000px;">
                    <!-- Cards injected here via JS -->
                </div>
            </div>

            <!-- Loading Screen -->
            <div id="cards-match-loading-screen" class="modal-body" style="padding: 2.5rem 1.5rem; flex-grow: 1; display: none; flex-direction: column; align-items: center; justify-content: center; background: #ffffff; text-align: center;">
                <span style="font-size: 3rem; display: block; margin-bottom: 0.75rem; animation: pulse 2s infinite;">⏳</span>
                <h3 style="font-size: 1.3rem; font-weight: 900; color: #000000; margin: 0 0 0.5rem 0;">Shuffling the Deck...</h3>
                <p style="font-size: 0.95rem; font-weight: 600; color: #64748b; max-width: 400px; margin: 0 auto;">
                    Gathering photos and setting up the board.
                </p>
            </div>

            <!-- End Screen -->
            <div id="cards-match-end-screen" class="modal-body" style="padding: 2.5rem 1.5rem; flex-grow: 1; display: none; flex-direction: column; align-items: center; justify-content: center; background: #ffffff; text-align: center;">
                <span style="font-size: 4rem; display: block; margin-bottom: 0.5rem;">🎉</span>
                <h3 style="font-size: 2rem; font-weight: 900; color: #000000; margin: 0 0 0.5rem 0;">You Won!</h3>
                <p id="cards-match-end-text" style="font-size: 1.05rem; font-weight: 600; color: #475569; margin: 0 0 1.5rem 0;">
                    You successfully found all matching pairs!
                </p>
                <div style="display: flex; gap: 1rem;">
                    <button class="btn btn-primary" style="padding: 0.6rem 1.75rem; border-radius: 50px; font-weight: 800; border: 2px solid #000000; box-shadow: 2px 2px 0px #000000;" onclick="startCardsMatch(window.cmState.currentDifficulty)">Play Again</button>
                    <button class="btn btn-outline" style="padding: 0.6rem 1.75rem; border-radius: 50px; font-weight: 800; border: 2px solid #000000; box-shadow: 2px 2px 0px #000000;" onclick="closeCardsMatchModal()">Exit</button>
                </div>
            </div>
            
        </div>
    </div>

</body>
</html>
