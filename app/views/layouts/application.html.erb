<!DOCTYPE html>
<html>
  <head>
    <title><%= content_for(:title) || "Mylnouss Core" %></title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <meta name="apple-mobile-web-app-capable" content="yes">
    <meta name="application-name" content="Mylnouss Core">
    <meta name="mobile-web-app-capable" content="yes">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>

    <%= yield :head %>

    <%# Enable PWA manifest for installable apps (make sure to enable in config/routes.rb too!) %>
    <%#= tag.link rel: "manifest", href: pwa_manifest_path(format: :json) %>

    <link rel="icon" href="/icon.png" type="image/png">
    <link rel="icon" href="/icon.svg" type="image/svg+xml">
    <link rel="apple-touch-icon" href="/icon.png">

    <%# Includes all stylesheet files in app/assets/stylesheets %>
    <%= stylesheet_link_tag :app, "data-turbo-track": "reload" %>
    <%= javascript_importmap_tags %>
  </head>

  <body class="dashboard-body">
    

    <!-- Top Navigation -->
        <nav class="app-navbar">
            <div class="navbar-brand">
                <span style="color: var(--color-primary); font-size: 1.4rem;">🍃</span>
                MYLNOUSS
            </div>
            <div class="navbar-actions">
                <a href="/public/site" target="_blank" class="btn btn-outline" style="border-radius: 50px; font-size: 0.85rem; padding: 0.35rem 1rem; text-decoration: none; display: inline-flex; align-items: center;">View Live Site &nearr;</a>
                <div class="avatar" style="width: 32px; height: 32px; font-size: 0.85rem;">AD</div>
            </div>
        </nav>

    <div class="app-shell">
            <!-- Left Sidebar -->
            <aside class="app-sidebar">
                
                <!-- System Setup Block -->
                <div class="sidebar-block">
                    <div class="sidebar-block-title">
                        <span>⚙️</span> System Setup
                    </div>
                    <ul class="sidebar-menu">
                        <li>
                            <a href="/profile" class="sidebar-link <%= 'active' if current_page?('/profile') %>">
                                <span>👥</span> User Profile
                            </a>
                        </li>
                        <li>
                            <a href="/photos" class="sidebar-link <%= 'active' if controller_name == 'photos' %>">
                                <span>📸</span> Post Photos
                            </a>
                        </li>
                        <li>
                            <a href="<%= guests_path %>" class="sidebar-link <%= 'active' if controller_name == 'guests' %>">
                                <span>🔒</span> Access Control
                            </a>
                        </li>
                        <li>
                            <a href="#" class="sidebar-link">
                                <span>💳</span> Subscription
                            </a>
                        </li>
                    </ul>
                </div>

                <!-- Features Block -->
                <div class="sidebar-block">
                    <div class="sidebar-block-title">
                        <span>🧩</span> Core Modules
                    </div>
                    <ul class="sidebar-menu">
                        <li>
                            <a href="#" class="sidebar-link">
                                <span>🎮</span> Module Launcher
                            </a>
                        </li>
                        <li>
                            <a href="#" class="sidebar-link">
                                <span>📓</span> Journal History
                            </a>
                        </li>
                    </ul>
                </div>

                <!-- Play Block -->
                <div class="sidebar-block">
                    <div class="sidebar-block-title">
                        <span>🎲</span> Play
                    </div>
                    <ul class="sidebar-menu">
                        <li>
                            <a href="#" class="sidebar-link <%= 'active' if controller_name == 'games' %>" onclick="toggleSidebarDropdown(event, 'games-dropdown', 'games-arrow')">
                                <span>🧩</span> Enjoy Games
                                <span class="dropdown-arrow" id="games-arrow">▼</span>
                            </a>
                            <div class="sidebar-dropdown" id="games-dropdown" style="<%= 'display: block;' if controller_name == 'games' %>">
                                <a href="/games/gallery" class="sidebar-dropdown-link <%= 'active' if action_name == 'gallery' %>">Photo Gallery</a>
                                <a href="/games/photo_memory" class="sidebar-dropdown-link <%= 'active' if action_name == 'photo_memory' %>">Photo Memory</a>
                                <a href="/games/career_quiz" class="sidebar-dropdown-link <%= 'active' if action_name == 'career_quiz' %>">Career Quiz</a>
                                <a href="#" class="sidebar-dropdown-link" onclick="openProfileQuizModal(event)">Picturez Quiz</a>
                                <a href="#" class="sidebar-dropdown-link" onclick="openCardsMatchModal(event)">Cards Match</a>
                                <a href="/games/crossword" class="sidebar-dropdown-link <%= 'active' if action_name == 'crossword' %>">Crossword</a>
                                <a href="/games/missing_word" class="sidebar-dropdown-link <%= 'active' if action_name == 'missing_word' %>">Missing Word</a>
                                <a href="/games/tic_tac_toe" class="sidebar-dropdown-link <%= 'active' if action_name == 'tic_tac_toe' %>">Tic-Tac-Toe</a>
                                <a href="/games/word_search" class="sidebar-dropdown-link <%= 'active' if action_name == 'word_search' %>">Word Search</a>
                                <a href="/games/create_a_story" class="sidebar-dropdown-link <%= 'active' if action_name == 'create_a_story' %>">Create a Story</a>
                                <a href="/games/critical_thinking" class="sidebar-dropdown-link <%= 'active' if action_name == 'critical_thinking' %>">Critical Thinking</a>
                                <a href="/games/lets_talk" class="sidebar-dropdown-link <%= 'active' if action_name == 'lets_talk' %>">Let's Talk</a>
                            </div>
                        </li>
                    </ul>
                </div>

                <!-- Daily Journal Block -->
                <div class="sidebar-block">
                    <div class="sidebar-block-title">
                        <span>📓</span> Daily Journal
                    </div>
                    <ul class="sidebar-menu">
                        <li>
                            <a href="<%= today_daily_journals_path %>" class="sidebar-link <%= 'active' if controller_name == 'daily_journals' %>">
                                <span>✍️</span> Keep Journal
                            </a>
                        </li>
                    </ul>
                </div>

                <!-- Footer Profile -->
                <div class="sidebar-footer">
                    Active Session:<br>
                    <strong>admin@mylnouss.local</strong>
                    <span class="sidebar-role-badge">Super Admin</span>
                </div>
            </aside>

            <!-- Center Content Area -->
            
          <%= yield %>


        <!-- Premium Dark Footer -->

    </div>

    <% @main_user = MainUser.first %>
    <script id="backend-profile-data" type="application/json">
        <%= raw(@main_user&.profile_data&.to_json || '{}') %>
    </script>
    




    <!-- Photo Lightbox Modal (TTS Viewer) -->
    <div class="modal-overlay" id="photo-lightbox-modal" style="z-index: 9999; background: rgba(0, 0, 0, 0.9);">
        <div style="position: relative; width: 100%; height: 100%; display: flex; flex-direction: column; align-items: center; justify-content: center; padding: 2rem;">
            <button class="close-modal-btn" onclick="closeLightbox()" style="position: absolute; top: 2rem; right: 2rem; color: white; background: rgba(255,255,255,0.1); border-radius: 50%; width: 48px; height: 48px; font-size: 2rem; border: none; cursor: pointer; transition: background 0.3s;">&times;</button>
            <div style="max-width: 900px; width: 100%; max-height: 70vh; display: flex; align-items: center; justify-content: center; margin-bottom: 2rem;">
                <img id="lightbox-image" src="" alt="Photo Viewer" style="max-width: 100%; max-height: 70vh; object-fit: contain; border-radius: 12px; box-shadow: 0 25px 50px -12px rgba(0,0,0,0.5);">
            </div>
            <div style="max-width: 800px; width: 100%; text-align: center;">
                <div style="display: inline-flex; align-items: center; gap: 0.75rem; background: var(--color-primary); color: white; padding: 0.5rem 1.5rem; border-radius: 50px; font-weight: 600; font-size: 0.9rem; margin-bottom: 1rem; box-shadow: 0 4px 6px -1px rgba(16, 185, 129, 0.4);">
                    <span style="font-size: 1.2rem;">🔊</span> Reading Message...
                </div>
                <p id="lightbox-description" style="color: white; font-size: 1.5rem; line-height: 1.6; font-weight: 500; text-shadow: 0 2px 4px rgba(0,0,0,0.5);"></p>
            </div>
        </div>
    </div>

    <!-- Picturez Quiz Modal -->
    <div class="modal-overlay" id="profile-quiz-modal" style="z-index: 9998; background: rgba(0, 0, 0, 0.7);">
        <div class="modal-content" style="max-width: 800px; width: 95%; min-height: 600px; display: flex; flex-direction: column; background: var(--color-bg); border-radius: 16px; overflow: hidden; box-shadow: 0 20px 40px rgba(0,0,0,0.3);">
            <div class="modal-header" style="background: white; border-bottom: 1px solid var(--color-border); padding: 1.5rem 2rem; display: flex; justify-content: space-between; align-items: center;">
                <h2 style="margin: 0; font-size: 1.5rem; color: var(--color-text-main);">🎮 Picturez Quiz</h2>
            </div>
            <div class="modal-body" id="quiz-body" style="flex: 1; display: flex; flex-direction: column; justify-content: center; align-items: center; padding: 2rem; text-align: center;">
                
                <div id="quiz-loading-state" style="display: flex; flex-direction: column; align-items: center; justify-content: center; height: 100%;">
                    <div style="font-size: 3rem; animation: spin 2s linear infinite;">⌛</div>
                    <h3 style="margin-top: 1.5rem; color: var(--color-text-main);">Generating personalized AI game...</h3>
                    <p style="color: var(--color-text-muted);">Crafting images based on your profile hobbies.</p>
                </div>
                
                <div id="quiz-game-state" style="display: none; width: 100%; max-width: 600px; flex-direction: column; align-items: center;">
                    <h3 id="quiz-progress" style="color: var(--color-primary); margin-bottom: 1.5rem; font-size: 1.2rem;">Round 1 of 5</h3>
                    <img id="quiz-image" src="" style="width: 100%; max-height: 300px; object-fit: contain; border-radius: 12px; box-shadow: var(--shadow-md); margin-bottom: 2rem;">
                    <div id="quiz-choices" style="display: grid; grid-template-columns: 1fr; gap: 1rem; width: 100%;">
                        <!-- Buttons injected via JS -->
                    </div>
                </div>

                <div id="quiz-end-state" style="display: none; width: 100%; text-align: center;">
                    <div style="font-size: 5rem; margin-bottom: 1rem;">🏆</div>
                    <h2 style="color: var(--color-text-main); margin-bottom: 0.5rem;">Game Complete!</h2>
                    <p style="font-size: 1.2rem; color: var(--color-text-muted); margin-bottom: 2rem;">You successfully identified all 5 pictures!</p>
                    <div style="display: flex; justify-content: center; gap: 1rem;">
                        <button class="btn btn-outline" style="padding: 0.75rem 2rem; border-radius: 50px; font-size: 1.1rem;" onclick="closeProfileQuizModal(event)">Close</button>
                        <button class="btn btn-primary" style="padding: 0.75rem 2rem; border-radius: 50px; font-size: 1.1rem; box-shadow: 0 4px 15px rgba(99, 102, 241, 0.4);" onclick="startProfileQuiz()">Play Again</button>
                    </div>
                </div>
            </div>
        </div>
    </div>
    
    <style>
        @keyframes spin { 100% { transform: rotate(360deg); } }
        .quiz-btn {
            background: var(--color-surface);
            border: 2px solid var(--color-border);
            border-radius: 12px;
            padding: 1rem;
            font-size: 1.2rem;
            font-weight: 600;
            color: var(--color-text-main);
            cursor: pointer;
            transition: all 0.2s;
            text-align: center;
        }
        .quiz-btn:hover:not(:disabled) {
            border-color: var(--color-primary);
            background: rgba(99, 102, 241, 0.1);
        }
        .quiz-btn.correct {
            background: #e6f4ea !important;
            border-color: #34a853 !important;
            color: #137333 !important;
        }
        .quiz-btn.wrong {
            background: #fce8e6 !important;
            border-color: #ea4335 !important;
            color: #c5221f !important;
        }
    </style>

    <!-- Cards Match Modal -->
    <div class="modal-overlay" id="cards-match-modal" style="z-index: 9998; background: rgba(0, 0, 0, 0.7);">
        <div id="cards-match-modal-content" class="modal-content" style="max-width: 700px; width: 95%; min-height: 600px; display: flex; flex-direction: column; background: var(--color-bg); border-radius: 16px; overflow: hidden; box-shadow: 0 20px 40px rgba(0,0,0,0.3); transition: max-width 0.4s ease;">
            
            <div class="modal-header" style="background: white; border-bottom: 1px solid var(--color-border); padding: 1.5rem 2rem; display: flex; justify-content: space-between; align-items: center;">
                <div>
                    <h2 style="font-size: 1.8rem; font-weight: 700; color: var(--color-text-main); margin: 0; display: flex; align-items: center; gap: 0.5rem;">
                        <span style="font-size: 2rem;">🎴</span> Cards Match
                    </h2>
                </div>
            </div>

            <!-- Game Screen -->
            <div id="cards-match-game-screen" class="modal-body" style="padding: 2rem; flex-grow: 1; display: none; flex-direction: column; background: var(--color-bg); align-items: center;">
                <div style="width: 100%; display: flex; justify-content: space-between; align-items: center; margin-bottom: 2rem;">
                    
                    <div style="display: flex; gap: 0.5rem; background: var(--color-bg-secondary); padding: 0.25rem; border-radius: 8px; border: 1px solid var(--color-border);">
                        <button id="cm-btn-easy" class="btn" onclick="startCardsMatch('easy')" style="padding: 0.5rem 1rem; border-radius: 6px; font-weight: 600;">Easy</button>
                        <button id="cm-btn-medium" class="btn btn-outline" onclick="startCardsMatch('medium')" style="padding: 0.5rem 1rem; border-radius: 6px; border: none; font-weight: 600;">Medium</button>
                        <button id="cm-btn-hard" class="btn btn-outline" onclick="startCardsMatch('hard')" style="padding: 0.5rem 1rem; border-radius: 6px; border: none; font-weight: 600;">Hard</button>
                    </div>

                    <div style="display: flex; align-items: center; gap: 1rem;">
                        <span id="cards-match-stats" style="font-size: 1.2rem; font-weight: 600; color: var(--color-text-main);">Matches: 0 / 4</span>
                        <button class="btn btn-outline" onclick="closeCardsMatchModal()" style="border-radius: 50%; width: 36px; height: 36px; display: flex; align-items: center; justify-content: center; padding: 0; color: #F44336; border-color: #F44336;" title="Close Game">✕</button>
                    </div>
                </div>
                
                <div id="cards-match-board" style="display: grid; gap: 1rem; width: 100%; max-width: 1000px; margin: 0 auto; perspective: 1000px;">
                    <!-- Cards injected here via JS -->
                </div>
            </div>

            <!-- Loading Screen -->
            <div id="cards-match-loading-screen" class="modal-body" style="padding: 4rem 2rem; flex-grow: 1; display: none; flex-direction: column; align-items: center; justify-content: center; background: var(--color-bg); text-align: center;">
                <span style="font-size: 4rem; display: block; margin-bottom: 1rem; animation: pulse 2s infinite;">⏳</span>
                <h3 style="font-size: 1.5rem; color: var(--color-text-main); margin: 0 0 1rem 0;">Shuffling the Deck...</h3>
                <p style="font-size: 1.1rem; color: var(--color-text-muted); max-width: 400px; margin: 0 auto;">
                    We are gathering photos and setting up the board. This might take a few moments if the AI is drawing new pictures!
                </p>
            </div>

            <!-- End Screen -->
            <div id="cards-match-end-screen" class="modal-body" style="padding: 4rem 2rem; flex-grow: 1; display: none; flex-direction: column; align-items: center; justify-content: center; background: var(--color-bg); text-align: center;">
                <span style="font-size: 5rem; display: block; margin-bottom: 1rem;">🎉</span>
                <h3 style="font-size: 2.5rem; color: var(--color-text-main); margin: 0 0 1rem 0;">You Won!</h3>
                <p id="cards-match-end-text" style="font-size: 1.2rem; color: var(--color-text-muted); margin: 0 0 2rem 0;">
                    You successfully found all matching pairs!
                </p>
                <div style="display: flex; gap: 1rem;">
                    <button class="btn btn-outline" onclick="startCardsMatch(window.cmState.currentDifficulty)">Play Again</button>
                    <button class="btn btn-primary" onclick="closeCardsMatchModal()">Exit</button>
                </div>
            </div>
            
        </div>
    </div>

</body>
</html>
