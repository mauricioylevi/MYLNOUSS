<main class="app-content">
<div style="max-width: 1200px; margin: 0 auto; padding: 2rem 1rem; width: 100%;">
  
  <!-- Header -->
  <div style="margin-bottom: 2rem; display: flex; justify-content: space-between; align-items: center; flex-wrap: wrap; gap: 1rem;">
    <div>
      <div style="display: flex; align-items: center; gap: 0.75rem;">
        <span style="font-size: 2.2rem; background: #dcfce7; padding: 0.4rem 0.6rem; border-radius: 12px; border: 2px solid #000000; box-shadow: 2px 2px 0px #000000;">👥</span>
        <div>
          <h1 style="font-size: 2.2rem; font-weight: 900; color: #000000; margin: 0; letter-spacing: -0.5px;">Family &amp; Loved Ones</h1>
          <p style="font-size: 1.05rem; color: var(--color-text-muted); margin: 0.25rem 0 0 0; font-weight: 600;">
            Invite family members and helpers to share photos, play games, and stay connected
          </p>
        </div>
      </div>
    </div>

    <a href="/" class="btn btn-outline" style="border-radius: 50px; padding: 0.5rem 1.25rem; font-size: 0.9rem; font-weight: 700; border: 2px solid #000000; box-shadow: 2px 2px 0px #000000;">
      &larr; Back to Dashboard
    </a>
  </div>

  <% if notice.present? %>
    <div style="background: #dcfce7; color: #065f46; border: 2px solid #000000; padding: 1rem 1.5rem; border-radius: 10px; margin-bottom: 2rem; font-weight: 700; box-shadow: 3px 3px 0px #000000;">
      <%= notice %>
    </div>
  <% end %>

  <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(380px, 1fr)); gap: 2rem;">
    
    <!-- LEFT COLUMN: Invite Guest Form Card -->
    <div style="display: flex; flex-direction: column;">
      <div style="background: #ffffff; border-radius: 14px; border: 2px solid #000000; padding: 2rem; box-shadow: var(--shadow-relief-md);">
        <div style="display: flex; align-items: center; gap: 0.6rem; margin-bottom: 1.25rem; border-bottom: 2px solid #f1f5f9; padding-bottom: 0.75rem;">
          <span style="font-size: 1.4rem;">✉️</span>
          <h3 style="margin: 0; font-size: 1.35rem; font-weight: 900; color: #000000;">Invite Family Member or Helper</h3>
        </div>
        
        <%= form_with model: @guest, url: guests_path, local: true do |f| %>
          <% if @guest.errors.any? %>
            <div style="background: #fee2e2; border: 1.5px solid #dc2626; color: #991b1b; padding: 1rem; border-radius: 8px; margin-bottom: 1.5rem; font-weight: 700;">
              <ul style="margin: 0; padding-left: 1.25rem;">
                <% @guest.errors.full_messages.each do |msg| %>
                  <li><%= msg %></li>
                <% end %>
              </ul>
            </div>
          <% end %>

          <div style="margin-bottom: 1rem;">
            <%= f.label :name, "Full Name", style: "display: block; margin-bottom: 0.35rem; font-weight: 800; font-size: 0.9rem; color: #000000;" %>
            <%= f.text_field :name, class: "form-control", placeholder: "e.g., Sarah Johnson", style: "width: 100%; padding: 0.7rem; border-radius: 8px; border: 2px solid #000000; background: #f8fafc; color: #000000; font-weight: 600; box-shadow: 2px 2px 0px #000000;", required: true %>
          </div>

          <div style="margin-bottom: 1.5rem;">
            <%= f.label :email, "Email Address", style: "display: block; margin-bottom: 0.35rem; font-weight: 800; font-size: 0.9rem; color: #000000;" %>
            <%= f.email_field :email, class: "form-control", placeholder: "e.g., sarah@example.com", style: "width: 100%; padding: 0.7rem; border-radius: 8px; border: 2px solid #000000; background: #f8fafc; color: #000000; font-weight: 600; box-shadow: 2px 2px 0px #000000;", required: true %>
          </div>

          <div style="background: #f8fafc; border: 2px solid #000000; border-radius: 10px; padding: 1.25rem; margin-bottom: 1.5rem; box-shadow: 2px 2px 0px #000000;">
            <div style="font-size: 0.85rem; font-weight: 800; text-transform: uppercase; color: #64748b; margin-bottom: 0.75rem;">
              Permissions Granted:
            </div>

            <div style="display: flex; flex-direction: column; gap: 0.75rem;">
              <label style="display: flex; align-items: center; gap: 0.75rem; cursor: pointer;">
                <%= f.check_box :can_post_photos, style: "width: 1.25rem; height: 1.25rem; cursor: pointer; accent-color: #059669;" %>
                <span style="color: #000000; font-weight: 700; font-size: 0.95rem;">📸 Post Photos to Album</span>
              </label>
              <label style="display: flex; align-items: center; gap: 0.75rem; cursor: pointer;">
                <%= f.check_box :can_play_games, style: "width: 1.25rem; height: 1.25rem; cursor: pointer; accent-color: #059669;" %>
                <span style="color: #000000; font-weight: 700; font-size: 0.95rem;">🎲 Play Games with Main User</span>
              </label>
              <label style="display: flex; align-items: center; gap: 0.75rem; cursor: pointer;">
                <%= f.check_box :can_read_journals, style: "width: 1.25rem; height: 1.25rem; cursor: pointer; accent-color: #059669;" %>
                <span style="color: #000000; font-weight: 700; font-size: 0.95rem;">📓 Access Daily Journals</span>
              </label>
            </div>
          </div>

          <div>
            <%= f.submit "Send Invitation", class: "btn btn-primary", style: "width: 100%; border-radius: 50px; font-weight: 800; font-size: 1rem; padding: 0.75rem; border: 2px solid #000000; box-shadow: 2px 2px 0px #000000;" %>
          </div>
        <% end %>
      </div>
    </div>

    <!-- RIGHT COLUMN: Invited Guests Card -->
    <div style="display: flex; flex-direction: column;">
      <div style="background: #ffffff; border-radius: 14px; border: 2px solid #000000; padding: 2rem; box-shadow: var(--shadow-relief-md); height: 100%;">
        <div style="display: flex; align-items: center; gap: 0.6rem; margin-bottom: 1.25rem; border-bottom: 2px solid #f1f5f9; padding-bottom: 0.75rem;">
          <span style="font-size: 1.4rem;">📋</span>
          <h3 style="margin: 0; font-size: 1.35rem; font-weight: 900; color: #000000;">Invited Guests</h3>
        </div>
        
        <% if @guests.empty? %>
          <div style="text-align: center; color: #64748b; padding: 3rem 1rem; background: #f8fafc; border: 2px dashed #cbd5e1; border-radius: 10px;">
            <span style="font-size: 2.5rem; display: block; margin-bottom: 0.5rem;">💌</span>
            <p style="margin: 0; font-weight: 700; font-size: 1rem; color: #000000;">No guests invited yet.</p>
            <p style="margin: 0.25rem 0 0 0; font-size: 0.88rem;">Use the form on the left to invite family members or helpers.</p>
          </div>
        <% else %>
          <div style="display: flex; flex-direction: column; gap: 1rem;">
            <% @guests.each do |guest| %>
              <div style="background: #f8fafc; border: 2px solid #000000; padding: 1.25rem; border-radius: 10px; box-shadow: 2px 2px 0px #000000; display: flex; flex-direction: column; gap: 0.5rem;">
                <div style="display: flex; justify-content: space-between; align-items: center; flex-wrap: wrap; gap: 0.5rem;">
                  <h4 style="margin: 0; font-size: 1.15rem; font-weight: 900; color: #000000;"><%= guest.name %></h4>
                  <span style="font-size: 0.8rem; font-weight: 800; padding: 0.2rem 0.65rem; border-radius: 50px; border: 1px solid #000000; background: <%= guest.registered? ? '#dcfce7' : '#fef3c7' %>; color: <%= guest.registered? ? '#065f46' : '#92400e' %>;">
                    <%= guest.registered? ? '✓ Registered' : '⏳ Pending Registration' %>
                  </span>
                </div>
                <p style="margin: 0; font-size: 0.9rem; color: #475569; font-weight: 600;"><%= guest.email %></p>
                
                <div style="display: flex; gap: 0.5rem; flex-wrap: wrap; margin-top: 0.5rem;">
                  <% if guest.can_post_photos %>
                    <span style="font-size: 0.75rem; font-weight: 800; background: #e0f2fe; color: #0369a1; border: 1px solid #000000; padding: 0.2rem 0.55rem; border-radius: 4px;">📸 Post Photos</span>
                  <% end %>
                  <% if guest.can_play_games %>
                    <span style="font-size: 0.75rem; font-weight: 800; background: #ede9fe; color: #5b21b6; border: 1px solid #000000; padding: 0.2rem 0.55rem; border-radius: 4px;">🎲 Play Games</span>
                  <% end %>
                  <% if guest.can_read_journals %>
                    <span style="font-size: 0.75rem; font-weight: 800; background: #fce7f3; color: #be185d; border: 1px solid #000000; padding: 0.2rem 0.55rem; border-radius: 4px;">📓 Read Journals</span>
                  <% end %>
                </div>

                <div style="display: flex; gap: 0.5rem; margin-top: 0.75rem; border-top: 1.5px solid #e2e8f0; padding-top: 0.75rem;">
                  <button type="button" class="btn btn-outline" style="font-size: 0.85rem; font-weight: 700; padding: 0.35rem 0.85rem; border-radius: 6px; border: 1.5px solid #000000;" onclick="document.getElementById('edit-guest-<%= guest.id %>').style.display = 'block'">Review Permissions</button>
                  <%= button_to "Remove Guest", guest_path(guest), method: :delete, form: { data: { turbo_confirm: 'Are you sure you want to remove this guest?' } }, class: "btn btn-outline", style: "font-size: 0.85rem; font-weight: 700; padding: 0.35rem 0.85rem; border-radius: 6px; color: #991b1b; border: 1.5px solid #000000; background: #fee2e2;" %>
                </div>

                <!-- Inline Edit Form -->
                <div id="edit-guest-<%= guest.id %>" style="display: none; margin-top: 0.75rem; padding: 1rem; background: #ffffff; border: 2px solid #000000; border-radius: 8px; box-shadow: 2px 2px 0px #000000;">
                  <h5 style="margin: 0 0 0.75rem 0; font-size: 0.95rem; font-weight: 900; color: #000000;">Edit Permissions</h5>
                  <%= form_with model: guest, url: guest_path(guest), method: :patch, local: true do |f| %>
                    <div style="display: flex; flex-direction: column; gap: 0.5rem; margin-bottom: 1rem;">
                      <label style="display: flex; align-items: center; gap: 0.5rem; cursor: pointer;">
                        <%= f.check_box :can_post_photos, style: "width: 1rem; height: 1rem; cursor: pointer;" %>
                        <span style="font-size: 0.9rem; font-weight: 700; color: #000000;">Post Photos remotely</span>
                      </label>
                      <label style="display: flex; align-items: center; gap: 0.5rem; cursor: pointer;">
                        <%= f.check_box :can_play_games, style: "width: 1rem; height: 1rem; cursor: pointer;" %>
                        <span style="font-size: 0.9rem; font-weight: 700; color: #000000;">Play games with Main User</span>
                      </label>
                      <label style="display: flex; align-items: center; gap: 0.5rem; cursor: pointer;">
                        <%= f.check_box :can_read_journals, style: "width: 1rem; height: 1rem; cursor: pointer;" %>
                        <span style="font-size: 0.9rem; font-weight: 700; color: #000000;">Access Main User Journals</span>
                      </label>
                    </div>
                    <div style="display: flex; gap: 0.5rem;">
                      <%= f.submit "Save Changes", class: "btn btn-primary", style: "font-size: 0.85rem; font-weight: 800; padding: 0.4rem 1rem; border-radius: 6px; border: 1.5px solid #000000;" %>
                      <button type="button" class="btn btn-outline" style="font-size: 0.85rem; font-weight: 700; padding: 0.4rem 1rem; border-radius: 6px; border: 1.5px solid #000000;" onclick="document.getElementById('edit-guest-<%= guest.id %>').style.display = 'none'">Cancel</button>
                    </div>
                  <% end %>
                </div>
              </div>
            <% end %>
          </div>
        <% end %>
      </div>
    </div>

  </div>
</div>
</main>
