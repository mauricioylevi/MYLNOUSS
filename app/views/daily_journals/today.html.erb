<main class="app-content">
<div style="max-width: 900px; margin: 0 auto; padding: 2rem 1rem; width: 100%;">
  <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 2rem;">
    <div>
      <h1 style="font-size: 2.5rem; font-weight: 800; color: var(--color-text-main); margin: 0;">Daily Journal</h1>
      <p style="font-size: 1.1rem; color: var(--color-text-muted); margin: 0.5rem 0 0 0;">
        <%= @journal.date.strftime("%A, %B %d, %Y") %>
      </p>
    </div>
    <div>
      <a href="<%= daily_journals_path %>" class="btn btn-outline" style="border-radius: 50px; font-weight: 600;">
        Journal History
      </a>
    </div>
  </div>

  <% if notice.present? %>
    <div style="background: rgba(16, 185, 129, 0.1); border: 1px solid var(--color-primary); color: var(--color-primary); padding: 1rem; border-radius: 8px; margin-bottom: 2rem; font-weight: 600;">
      <%= notice %>
    </div>
  <% end %>
  <% if alert.present? %>
    <div style="background: rgba(239, 68, 68, 0.1); border: 1px solid #ef4444; color: #ef4444; padding: 1rem; border-radius: 8px; margin-bottom: 2rem; font-weight: 600;">
      <%= alert %>
    </div>
  <% end %>

  <%= form_with url: daily_journals_path, method: :post, local: true, id: "daily-journal-form" do |f| %>
    <div style="display: flex; flex-direction: column; gap: 1.5rem;">
      
      <% cards = [
        { key: 'exercise', icon: '🏋️', title: 'Exercise of the day', desc: 'Get your body moving.' },
        { key: 'book', icon: '📖', title: 'Read a book', desc: 'Dive into a good story.' },
        { key: 'news', icon: '📰', title: 'Read news', desc: 'Stay updated with the world.' },
        { key: 'hobby', icon: '🎨', title: 'Hobby', desc: 'Spend time on what you love.' },
        { key: 'movie', icon: '🎬', title: 'Watch movie', desc: 'Enjoy a film or show.' },
        { key: 'games', icon: '🎲', title: 'Perform games', desc: 'Have fun with some games.' },
        { key: 'invite', icon: '☕', title: 'Invite people over', desc: 'Host some wonderful company.' }
      ] %>
      
      <% cards.each do |card| %>
        <div style="background: var(--color-surface); border-radius: 12px; border: 1px solid var(--color-border); padding: 1.5rem; display: flex; flex-direction: column; gap: 1rem; box-shadow: var(--shadow-sm);">
          <div style="display: flex; align-items: center; gap: 1rem;">
            <div style="font-size: 2.5rem; background: var(--color-bg); width: 60px; height: 60px; display: flex; align-items: center; justify-content: center; border-radius: 12px;">
              <%= card[:icon] %>
            </div>
            <div>
              <h3 style="margin: 0; font-size: 1.25rem; color: var(--color-text-main); font-weight: 600;"><%= card[:title] %></h3>
              <p style="margin: 0; font-size: 0.95rem; color: var(--color-text-muted)"><%= card[:desc] %></p>
            </div>
          </div>
          
          <div style="position: relative;">
            <label for="<%= card[:key] %>" style="display: flex; justify-content: space-between; font-size: 0.85rem; font-weight: 600; color: var(--color-text-main); margin-bottom: 0.5rem; text-transform: uppercase; letter-spacing: 0.5px; cursor: pointer;">
              <span>Add new thoughts:</span>
              <span id="counter-<%= card[:key] %>" style="color: var(--color-text-muted);">
                <%= @journal.entries[card[:key]].to_s.length %> / 200
              </span>
            </label>
            <%= f.text_area card[:key], 
                id: card[:key],
                value: @journal.entries[card[:key]],
                class: "text-input journal-textarea", 
                placeholder: "Write about this activity...",
                rows: 3, 
                maxlength: 200,
                style: "display: block; width: 100%; min-height: 80px; box-sizing: border-box; resize: vertical; font-size: 1rem; font-family: inherit; color: var(--color-text-main); background: var(--color-bg); padding: 1rem; border-radius: 8px; border: 1px solid var(--color-border);",
                data: { counter_id: "counter-#{card[:key]}" } %>
          </div>

        </div>
      <% end %>
      
    </div>

    <div style="margin-top: 2.5rem; text-align: right;">
      <button type="submit" class="btn btn-primary" style="padding: 1rem 3rem; border-radius: 50px; font-size: 1.1rem; font-weight: 600; box-shadow: 0 10px 15px -3px rgba(99, 102, 241, 0.4);">
        Save Journal
      </button>
    </div>
  <% end %>
</div>

<script>
  document.addEventListener("turbo:load", () => {
    const textareas = document.querySelectorAll('.journal-textarea');
    textareas.forEach(ta => {
      ta.addEventListener('input', (e) => {
        const counterId = e.target.getAttribute('data-counter-id');
        const counter = document.getElementById(counterId);
        if (counter) {
          counter.textContent = `${e.target.value.length} / 200`;
        }
      });
    });
  });
</script>
</main>
