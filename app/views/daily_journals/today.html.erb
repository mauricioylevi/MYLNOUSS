<main class="app-content">
<div style="max-width: 900px; margin: 0 auto; padding: 2rem 1rem; width: 100%;">
  
  <!-- Header -->
  <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 2rem; flex-wrap: wrap; gap: 1rem;">
    <div style="display: flex; align-items: center; gap: 0.75rem;">
      <span style="font-size: 2.2rem; background: #dbeafe; padding: 0.4rem 0.6rem; border-radius: 12px; border: 2px solid #000000; box-shadow: 2px 2px 0px #000000;">✍️</span>
      <div>
        <h1 style="font-size: 2.2rem; font-weight: 900; color: #000000; margin: 0; letter-spacing: -0.5px;">Today's Daily Journal</h1>
        <p style="font-size: 1.05rem; color: var(--color-text-muted); margin: 0.25rem 0 0 0; font-weight: 600;">
          <%= @journal.date.strftime("%A, %B %d, %Y") %> &bull; Record your daily thoughts & reflections
        </p>
      </div>
    </div>
    <div style="display: flex; gap: 0.75rem;">
      <a href="<%= daily_journals_path %>" class="btn btn-outline" style="border-radius: 50px; font-weight: 700; padding: 0.5rem 1.25rem; font-size: 0.9rem; border: 2px solid #000000; box-shadow: 2px 2px 0px #000000;">
        📓 Journal History
      </a>
      <a href="/" class="btn btn-outline" style="border-radius: 50px; font-weight: 700; padding: 0.5rem 1.25rem; font-size: 0.9rem; border: 2px solid #000000; box-shadow: 2px 2px 0px #000000;">
        &larr; Exit
      </a>
    </div>
  </div>

  <% if notice.present? %>
    <div style="background: #dcfce7; border: 2px solid #000000; color: #065f46; padding: 1rem 1.5rem; border-radius: 10px; margin-bottom: 2rem; font-weight: 700; box-shadow: 3px 3px 0px #000000;">
      <%= notice %>
    </div>
  <% end %>
  <% if alert.present? %>
    <div style="background: #fee2e2; border: 2px solid #000000; color: #991b1b; padding: 1rem 1.5rem; border-radius: 10px; margin-bottom: 2rem; font-weight: 700; box-shadow: 3px 3px 0px #000000;">
      <%= alert %>
    </div>
  <% end %>

  <%= form_with url: daily_journals_path, method: :post, local: true, id: "daily-journal-form" do |f| %>
    <div style="display: flex; flex-direction: column; gap: 1.5rem;">
      
      <% cards = [
        { key: 'exercise', icon: '🏋️', title: 'Exercise of the day', desc: 'Get your body moving and active.' },
        { key: 'book', icon: '📖', title: 'Read a book', desc: 'Dive into a good story or article.' },
        { key: 'news', icon: '📰', title: 'Read news', desc: 'Stay updated with the world.' },
        { key: 'hobby', icon: '🎨', title: 'Hobby & Creativity', desc: 'Spend time on what you love.' },
        { key: 'movie', icon: '🎬', title: 'Watch movie or show', desc: 'Enjoy a relaxing film or favorite program.' },
        { key: 'games', icon: '🎲', title: 'Brain Games', desc: 'Have fun exercising your logic and memory.' },
        { key: 'invite', icon: '☕', title: 'Time with Family & Friends', desc: 'Enjoy great company or a call with loved ones.' }
      ] %>
      
      <% cards.each do |card| %>
        <div style="background: #ffffff; border-radius: 14px; border: 2px solid #000000; padding: 1.5rem; display: flex; flex-direction: column; gap: 1rem; box-shadow: var(--shadow-relief-md);">
          <div style="display: flex; align-items: center; gap: 1rem;">
            <div style="font-size: 2.2rem; background: #f8fafc; border: 1.5px solid #000000; width: 58px; height: 58px; display: flex; align-items: center; justify-content: center; border-radius: 12px; box-shadow: 2px 2px 0px #000000;">
              <%= card[:icon] %>
            </div>
            <div>
              <h3 style="margin: 0; font-size: 1.25rem; color: #000000; font-weight: 900;"><%= card[:title] %></h3>
              <p style="margin: 0.15rem 0 0 0; font-size: 0.95rem; color: #475569; font-weight: 600;"><%= card[:desc] %></p>
            </div>
          </div>
          
          <div style="position: relative;">
            <label for="<%= card[:key] %>" style="display: flex; justify-content: space-between; font-size: 0.85rem; font-weight: 800; color: #000000; margin-bottom: 0.4rem; text-transform: uppercase; letter-spacing: 0.5px; cursor: pointer;">
              <span>Add your thoughts:</span>
              <span id="counter-<%= card[:key] %>" style="color: #64748b; font-weight: 700;">
                <%= @journal.entries[card[:key]].to_s.length %> / 200
              </span>
            </label>
            <%= f.text_area card[:key], 
                id: card[:key],
                value: @journal.entries[card[:key]],
                class: "text-input journal-textarea", 
                placeholder: "Type or speak your thoughts about this activity...",
                rows: 3, 
                maxlength: 200,
                style: "display: block; width: 100%; min-height: 85px; box-sizing: border-box; resize: vertical; font-size: 1rem; font-family: inherit; color: #000000; font-weight: 600; background: #f8fafc; padding: 1rem; border-radius: 8px; border: 2px solid #000000; box-shadow: 2px 2px 0px #000000;",
                data: { counter_id: "counter-#{card[:key]}" } %>
          </div>

        </div>
      <% end %>
      
    </div>

    <div style="margin-top: 2.5rem; text-align: right;">
      <button type="submit" class="btn btn-primary" style="padding: 1rem 3.5rem; border-radius: 50px; font-size: 1.15rem; font-weight: 800; border: 2px solid #000000; box-shadow: 3px 3px 0px #000000;">
        ✓ Save Today's Journal
      </button>
    </div>
  <% end %>
</div>

<script>
  document.addEventListener("turbo:load", () => {
    const textareas = document.querySelectorAll('.journal-textarea');
    textareas.forEach(ta => {
      ta.addEventListener('input', (e) => {
        const counterId = e.target.getAttribute('data-counter-id');
        const counter = document.getElementById(counterId);
        if (counter) {
          counter.textContent = `${e.target.value.length} / 200`;
        }
      });
    });
  });
</script>
</main>
