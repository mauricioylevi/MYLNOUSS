<main class="app-content">
<div style="max-width: 900px; margin: 0 auto; padding: 2rem 1rem; width: 100%;">
  <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 2rem;">
    <div>
      <h1 style="font-size: 2.5rem; font-weight: 800; color: var(--color-text-main); margin: 0;">Daily Journal</h1>
      <p style="font-size: 1.1rem; color: var(--color-text-muted); margin: 0.5rem 0 0 0;">
        <%= @date.strftime("%A, %B %d, %Y") %>
      </p>
    </div>
    <div>
      <a href="<%= daily_journals_path %>" class="btn btn-outline" style="border-radius: 50px; font-weight: 600;">
        &larr; Back to History
      </a>
    </div>
  </div>

  <div style="display: flex; flex-direction: column; gap: 3rem;">
    
    <% cards = [
      { key: 'exercise', icon: '🏋️', title: 'Exercise of the day' },
      { key: 'book', icon: '📖', title: 'Read a book' },
      { key: 'news', icon: '📰', title: 'Read news' },
      { key: 'hobby', icon: '🎨', title: 'Hobby' },
      { key: 'movie', icon: '🎬', title: 'Watch movie' },
      { key: 'games', icon: '🎲', title: 'Perform games' },
      { key: 'invite', icon: '☕', title: 'Invite people over' }
    ] %>
    
    <% has_any_entries = false %>
    <% cards.each do |card| %>
      <% topic_entries = @journals.select { |j| j.entries[card[:key]].present? } %>
      <% if topic_entries.any? %>
        <% has_any_entries = true %>
        <div style="background: var(--color-surface); border-radius: 12px; border: 1px solid var(--color-border); padding: 1.5rem; display: flex; flex-direction: column; gap: 1rem; box-shadow: var(--shadow-sm);">
          <div style="display: flex; align-items: center; gap: 1rem; border-bottom: 1px solid var(--color-border); padding-bottom: 1rem; margin-bottom: 0.5rem;">
            <div style="font-size: 2.5rem; background: var(--color-bg); width: 60px; height: 60px; display: flex; align-items: center; justify-content: center; border-radius: 12px;">
              <%= card[:icon] %>
            </div>
            <div>
              <h3 style="margin: 0; font-size: 1.25rem; color: var(--color-text-main); font-weight: 600;"><%= card[:title] %></h3>
            </div>
          </div>
          
          <div style="display: flex; flex-direction: column; gap: 1.25rem;">
            <% topic_entries.reverse.each do |journal| %>
              <div style="display: flex; gap: 1.5rem; align-items: flex-start;">
                <div class="local-time" data-utc-time="<%= journal.created_at.iso8601 %>" style="font-size: 0.95rem; font-weight: 700; color: var(--color-primary); white-space: nowrap; padding-top: 0.15rem; min-width: 80px;">
                  <%= journal.created_at.strftime("%I:%M %p") %>
                </div>
                <div style="color: var(--color-text-main); font-size: 1.05rem; line-height: 1.6; white-space: pre-wrap; flex: 1;">
                  <%= journal.entries[card[:key]] %>
                </div>
              </div>
            <% end %>
          </div>
          
        </div>
      <% end %>
    <% end %>
    
    <% if !has_any_entries %>
      <div style="text-align: center; padding: 3rem; background: var(--color-surface); border-radius: 12px; color: var(--color-text-muted);">
        No entries were recorded on this day.
      </div>
    <% end %>
    
  </div>
</div>
</main>

<script>
  function formatLocalTimes() {
    document.querySelectorAll('.local-time').forEach(el => {
      const utcTime = el.getAttribute('data-utc-time');
      if (utcTime) {
        const date = new Date(utcTime);
        let hours = date.getHours();
        let minutes = date.getMinutes();
        const ampm = hours >= 12 ? 'PM' : 'AM';
        hours = hours % 12;
        hours = hours ? hours : 12; // the hour '0' should be '12'
        minutes = minutes < 10 ? '0' + minutes : minutes;
        const strTime = hours.toString().padStart(2, '0') + ':' + minutes + ' ' + ampm;
        el.textContent = strTime;
        el.classList.remove('local-time');
      }
    });
  }
  
  // Run on page load
  formatLocalTimes();
  // Support Turbo navigation
  document.addEventListener("turbo:load", formatLocalTimes);
</script>
