<main class="app-content">
<div style="max-width: 800px; margin: 0 auto; padding: 2rem 1rem; width: 100%;">
  
  <!-- Header -->
  <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 2rem; flex-wrap: wrap; gap: 1rem;">
    <div style="display: flex; align-items: center; gap: 0.75rem;">
      <span style="font-size: 2.2rem; background: #dbeafe; padding: 0.4rem 0.6rem; border-radius: 12px; border: 2px solid #000000; box-shadow: 2px 2px 0px #000000;">📓</span>
      <div>
        <h1 style="font-size: 2.2rem; font-weight: 900; color: #000000; margin: 0; letter-spacing: -0.5px;">Journal History</h1>
        <p style="font-size: 1.05rem; color: var(--color-text-muted); margin: 0.25rem 0 0 0; font-weight: 600;">
          Review your reflections and memories by day
        </p>
      </div>
    </div>
    <div style="display: flex; gap: 0.75rem;">
      <a href="<%= today_daily_journals_path %>" class="btn btn-primary" style="border-radius: 50px; font-weight: 800; padding: 0.55rem 1.35rem; font-size: 0.95rem; border: 2px solid #000000; box-shadow: 2px 2px 0px #000000;">
        ✍️ Write Today's Journal
      </a>
      <a href="/" class="btn btn-outline" style="border-radius: 50px; font-weight: 700; padding: 0.55rem 1.25rem; font-size: 0.9rem; border: 2px solid #000000; box-shadow: 2px 2px 0px #000000;">
        &larr; Exit
      </a>
    </div>
  </div>

  <% if @journal_stats.empty? %>
    <div style="text-align: center; padding: 3.5rem 1.5rem; background: #ffffff; border-radius: 14px; border: 2px dashed #000000; box-shadow: var(--shadow-relief-md);">
      <span style="font-size: 3rem; display: block; margin-bottom: 0.75rem;">📓</span>
      <h3 style="margin: 0; color: #000000; font-size: 1.35rem; font-weight: 900;">No Journals Recorded Yet</h3>
      <p style="color: #64748b; font-size: 1rem; font-weight: 600; margin: 0.5rem 0 1.5rem 0;">Start recording your daily thoughts, activities, and reflections!</p>
      <a href="<%= today_daily_journals_path %>" class="btn btn-primary" style="border-radius: 50px; font-weight: 800; padding: 0.65rem 1.75rem; border: 2px solid #000000; box-shadow: 2px 2px 0px #000000;">
        Create First Entry
      </a>
    </div>
  <% else %>
    <div style="display: flex; flex-direction: column; gap: 1rem;">
      <% @journal_stats.each do |date, count| %>
        <a href="<%= daily_journal_path(date.to_s) %>" style="text-decoration: none; display: block;">
          <div style="background: #ffffff; border-radius: 12px; border: 2px solid #000000; padding: 1.15rem 1.5rem; display: flex; justify-content: space-between; align-items: center; box-shadow: var(--shadow-relief-md); transition: transform 0.15s, box-shadow 0.15s, background 0.15s;" onmouseover="this.style.background='#f8fafc'; this.style.transform='translateY(-2px)';" onmouseout="this.style.background='#ffffff'; this.style.transform='translateY(0)';">
            <div style="display: flex; align-items: center; gap: 1rem;">
              <span style="font-size: 1.8rem; background: #f8fafc; border: 1.5px solid #000000; width: 48px; height: 48px; display: flex; align-items: center; justify-content: center; border-radius: 10px; box-shadow: 1.5px 1.5px 0px #000000;">📅</span>
              <div>
                <h3 style="margin: 0 0 0.2rem 0; font-size: 1.15rem; color: #000000; font-weight: 900;">
                  <%= date.strftime("%A, %B %d, %Y") %>
                </h3>
                <p style="margin: 0; font-size: 0.9rem; color: #64748b; font-weight: 700;">
                  <%= pluralize(count, 'thought') %> recorded
                </p>
              </div>
            </div>
            <div style="display: flex; align-items: center; gap: 0.5rem;">
              <span style="font-size: 0.85rem; font-weight: 800; color: #2563eb; background: #eff6ff; border: 1px solid #000000; padding: 0.25rem 0.75rem; border-radius: 50px;">View Entry</span>
              <span style="color: #000000; font-size: 1.3rem; font-weight: 900;">&rarr;</span>
            </div>
          </div>
        </a>
      <% end %>
    </div>
  <% end %>
</div>
</main>
