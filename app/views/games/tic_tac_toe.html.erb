<main class="app-content" style="padding: 1rem 1.5rem; height: calc(100vh - 70px); box-sizing: border-box; display: flex; flex-direction: column;">
  <div style="display: flex; flex-direction: column; height: 100%; background: #ffffff; border: 2px solid #000000; border-radius: 14px; overflow: hidden; box-shadow: var(--shadow-relief-md);">
    
    <!-- Header -->
    <header style="padding: 0.65rem 1.5rem; border-bottom: 2px solid #000000; display: flex; justify-content: space-between; align-items: center; background: #ffffff; flex-shrink: 0; gap: 1rem;">
      <div style="display: flex; align-items: center; gap: 0.75rem;">
        <span style="font-size: 1.6rem; background: #ede9fe; padding: 0.2rem 0.45rem; border-radius: 8px; border: 1.5px solid #000000; box-shadow: 1.5px 1.5px 0px #000000;">❌⭕</span>
        <div>
          <h2 style="font-size: 1.35rem; font-weight: 900; color: #000000; margin: 0; line-height: 1.2;">
            Tic-Tac-Toe
          </h2>
          <span style="color: var(--color-text-muted); font-size: 0.8rem; font-weight: 600;">
            Classic strategy match against computer or partner
          </span>
        </div>
      </div>
      <div style="display: flex; gap: 0.5rem; align-items: center;">
        <button class="btn btn-outline btn-compact" onclick="resetTicTacToe()" style="border-radius: 50px; font-weight: 700; border: 1.5px solid #000000;">
          🔄 Reset
        </button>
        <a href="/" class="btn btn-outline btn-compact" style="border-radius: 50px; font-weight: 700; border: 1.5px solid #000000;">
          &larr; Exit
        </a>
      </div>
    </header>

    <!-- Game Container (Top Aligned) -->
    <div style="flex: 1; padding: 1.25rem 1.5rem; display: flex; flex-direction: column; align-items: center; justify-content: flex-start; position: relative; overflow-y: auto;">
        
        <!-- Game State -->
        <div id="tic-tac-toe-game-screen" style="display: flex; flex-direction: column; align-items: center; max-width: 500px; text-align: center; width: 100%;">
            
            <div style="display: flex; gap: 0.5rem; background: #f8fafc; padding: 0.35rem; border-radius: 50px; border: 2px solid #000000; margin-bottom: 0.75rem; box-shadow: 2px 2px 0px #000000;">
                <button id="mode-btn-1player" class="btn btn-primary" style="border-radius: 50px; padding: 0.35rem 1.25rem; font-size: 0.9rem; border: 1.5px solid #000000; font-weight: 800; transition: all 0.2s;" onclick="startTicTacToe('1player')">🤖 1 Player</button>
                <button id="mode-btn-2player" style="background: transparent; color: #475569; border-radius: 50px; padding: 0.35rem 1.25rem; font-size: 0.9rem; border: none; font-weight: 800; transition: all 0.2s; cursor: pointer;" onclick="startTicTacToe('2player')">👥 2 Players</button>
            </div>

            <div style="background: #ede9fe; border: 1.5px solid #000000; padding: 0.4rem 1.25rem; border-radius: 50px; margin-bottom: 0.75rem; box-shadow: 1.5px 1.5px 0px #000000;">
                <h3 id="tic-tac-toe-status" style="font-size: 1.1rem; color: #5b21b6; font-weight: 900; margin: 0;">
                    Player X's Turn
                </h3>
            </div>
            
            <div id="tic-tac-toe-board" style="display: grid; grid-template-columns: repeat(3, 1fr); grid-template-rows: repeat(3, 1fr); width: 100%; max-width: 320px; aspect-ratio: 1; gap: 8px; background: #f8fafc; border: 2px solid #000000; border-radius: 16px; box-shadow: var(--shadow-relief-md); padding: 10px;">
                <% 9.times do |i| %>
                    <div class="tic-tac-toe-cell" data-index="<%= i %>" onclick="handleTicTacToeClick(<%= i %>)"></div>
                <% end %>
            </div>
        </div>

        <!-- End State Overlay -->
        <div id="tic-tac-toe-end-screen" style="display: none; flex-direction: column; align-items: center; text-align: center; position: absolute; inset: 0; background: rgba(255,255,255,0.95); justify-content: center; backdrop-filter: blur(4px); z-index: 10; padding: 2rem;">
            <div id="tic-tac-toe-winner-icon" style="font-size: 4.5rem; margin-bottom: 0.5rem;">🏆</div>
            <h2 id="tic-tac-toe-winner-text" style="color: #000000; margin-bottom: 0.5rem; font-size: 2.2rem; font-weight: 900;">Player X Wins!</h2>
            <div style="display: flex; justify-content: center; gap: 1rem; margin-top: 1.25rem;">
                <a href="/" class="btn btn-outline" style="padding: 0.6rem 1.75rem; border-radius: 50px; font-size: 0.95rem; font-weight: 800; border: 2px solid #000000; box-shadow: 2px 2px 0px #000000;">Exit</a>
                <button class="btn btn-primary" style="padding: 0.6rem 1.75rem; border-radius: 50px; font-size: 0.95rem; font-weight: 800; border: 2px solid #000000; box-shadow: 2px 2px 0px #000000;" onclick="resetTicTacToe()">Play Again</button>
            </div>
        </div>

    </div>
  </div>
</main>

<style>
.tic-tac-toe-cell {
    display: flex;
    justify-content: center;
    align-items: center;
    font-size: 3.5rem;
    font-weight: 900;
    cursor: pointer;
    user-select: none;
    background: #ffffff;
    border: 2px solid #000000;
    border-radius: 10px;
    box-shadow: 1.5px 1.5px 0px #000000;
    transition: all 0.15s ease;
}

.tic-tac-toe-cell:hover {
    background: #ede9fe;
    transform: scale(1.02);
}

.tic-tac-toe-cell.x {
    color: #2563eb;
}

.tic-tac-toe-cell.o {
    color: #dc2626;
}
</style>

<script>
    if (typeof initTicTacToePage === 'function') {
        initTicTacToePage();
    } else {
        setTimeout(() => {
            if (typeof initTicTacToePage === 'function') initTicTacToePage();
        }, 100);
    }
</script>
