<main class="app-content">
  <div style="display: flex; flex-direction: column; height: 100%; background: var(--color-bg); border-radius: 16px; overflow: hidden; box-shadow: 0 4px 20px rgba(0,0,0,0.05);">
    
    <!-- Header -->
    <div style="padding: 1.5rem 2rem; border-bottom: 1px solid var(--color-border); display: flex; justify-content: space-between; align-items: center; background: var(--color-surface);">
        <div>
            <h2 style="font-size: 1.8rem; font-weight: 700; color: var(--color-text-main); margin: 0; display: flex; align-items: center; gap: 0.5rem;">
                <span style="font-size: 2rem;">📸</span> Photo Trivia
            </h2>
            <p style="color: var(--color-text-muted); margin: 0.25rem 0 0 0; font-size: 0.95rem;">What was said in this picture?</p>
        </div>
        <div>
            <a href="/" class="btn btn-outline" style="border-radius: 50px; padding: 0.4rem 1rem; font-size: 0.9rem;">&larr; Back to Dashboard</a>
        </div>
    </div>

    <!-- Game Container -->
    <div style="flex: 1; padding: 2rem; display: flex; flex-direction: column; align-items: center; justify-content: center; position: relative; overflow-y: auto;">
        
        <% if @game_data.nil? || @game_data['rounds'].empty? %>
            <div style="text-align: center;">
                <h3 style="font-size: 1.5rem; color: var(--color-text-main); margin-bottom: 1rem;">Not enough photos yet!</h3>
                <p style="color: var(--color-text-muted); margin-bottom: 2rem;">Add descriptions to your photos in the dashboard to play this game.</p>
                <a href="/" class="btn btn-primary" style="padding: 0.75rem 2rem; border-radius: 50px;">Go to Gallery</a>
            </div>
        <% else %>
            <div id="photo-trivia-container" data-rounds="<%= @game_data['rounds'].to_json %>" style="width: 100%; max-width: 600px; display: flex; flex-direction: column; align-items: center;">
                
                <div id="pt-round-indicator" style="font-size: 1rem; font-weight: 600; color: var(--color-text-muted); margin-bottom: 1rem; text-transform: uppercase; letter-spacing: 1px;">Round 1 / 3</div>
                
                <div style="width: 100%; margin-bottom: 1.5rem; text-align: center;">
                    <img id="pt-photo" src="" alt="Trivia Photo" style="max-width: 100%; max-height: 55vh; border-radius: 12px; box-shadow: 0 4px 15px rgba(0,0,0,0.1);">
                </div>
                
                <h3 style="font-size: 1.5rem; color: var(--color-text-main); margin-bottom: 1.5rem; text-align: center;">What was said in this picture?</h3>
                
                <div id="pt-options" style="display: flex; flex-direction: column; gap: 1rem; width: 100%;">
                    <!-- Options injected here -->
                </div>
                
                <div id="pt-feedback" style="display: none; margin-top: 1.5rem; padding: 1rem; border-radius: 12px; width: 100%; text-align: center; font-weight: 700; font-size: 1.2rem;">
                    <!-- Feedback injected here -->
                </div>
                
            </div>
            
            <div id="photo-trivia-end-screen" style="display: none; text-align: center; flex-direction: column; align-items: center;">
                <div style="font-size: 4rem; margin-bottom: 1rem;">🎉</div>
                <h2 style="font-size: 2.2rem; color: var(--color-text-main); margin-bottom: 1rem;">Trivia Complete!</h2>
                <p id="pt-score-text" style="font-size: 1.2rem; color: var(--color-text-muted); margin-bottom: 2rem;">You remembered your memories well.</p>
                <div style="display: flex; gap: 1rem;">
                    <button class="btn btn-primary" onclick="window.location.reload()" style="padding: 0.75rem 2rem; border-radius: 50px; font-size: 1.1rem; box-shadow: 0 4px 15px rgba(99, 102, 241, 0.4);">Play Again</button>
                    <a href="/" class="btn btn-outline" style="padding: 0.75rem 2rem; border-radius: 50px; font-size: 1.1rem; color: #DC2626; border-color: #fca5a5; background: #fef2f2;">Exit to Dashboard</a>
                </div>
            </div>
        <% end %>

    </div>
  </div>
</main>

<style>
.pt-option-btn {
    background: var(--color-surface);
    border: 2px solid var(--color-border);
    padding: 1.25rem 1.5rem;
    border-radius: 12px;
    font-size: 1.1rem;
    color: var(--color-text-main);
    cursor: pointer;
    transition: all 0.2s;
    text-align: left;
    box-shadow: 0 2px 5px rgba(0,0,0,0.02);
}
.pt-option-btn:hover {
    border-color: var(--color-primary);
    background: rgba(99, 102, 241, 0.05);
    transform: translateY(-2px);
}
.pt-option-btn.correct {
    background: #d1fae5;
    border-color: #10b981;
    color: #065f46;
}
.pt-option-btn.wrong {
    background: #fee2e2;
    border-color: #ef4444;
    color: #991b1b;
}
</style>

<script>
    if (typeof initPhotoTriviaPage === 'function') {
        initPhotoTriviaPage();
    } else {
        setTimeout(() => {
            if (typeof initPhotoTriviaPage === 'function') initPhotoTriviaPage();
        }, 100);
    }
</script>
