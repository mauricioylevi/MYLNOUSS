<main class="app-content" style="padding: 1rem 1.5rem; height: calc(100vh - 70px); box-sizing: border-box; display: flex; flex-direction: column;">
  <div style="display: flex; flex-direction: column; height: 100%; background: #ffffff; border: 2px solid #000000; border-radius: 14px; overflow: hidden; box-shadow: var(--shadow-relief-md);">
    
    <!-- Header -->
    <header style="padding: 0.65rem 1.5rem; border-bottom: 2px solid #000000; display: flex; justify-content: space-between; align-items: center; background: #ffffff; flex-shrink: 0; gap: 1rem;">
      <div style="display: flex; align-items: center; gap: 0.75rem;">
        <span style="font-size: 1.6rem; background: #ede9fe; padding: 0.2rem 0.45rem; border-radius: 8px; border: 1.5px solid #000000; box-shadow: 1.5px 1.5px 0px #000000;">📝</span>
        <div>
          <h2 style="font-size: 1.35rem; font-weight: 900; color: #000000; margin: 0; line-height: 1.2;">
            Crossword
          </h2>
          <span style="color: var(--color-text-muted); font-size: 0.8rem; font-weight: 600;">
            Solve words across and down from memory clues
          </span>
        </div>
      </div>
      <div style="display: flex; gap: 0.6rem; align-items: center;">
        <div style="display: flex; background: #f8fafc; border-radius: 50px; padding: 0.2rem; border: 1.5px solid #000000;">
          <button id="cw-btn-easy" class="btn btn-compact" style="padding: 0.3rem 0.85rem; font-size: 0.82rem; font-weight: 800; border-radius: 50px;" onclick="startCrossword('easy')">Easy</button>
          <button id="cw-btn-medium" class="btn btn-outline btn-compact" style="padding: 0.3rem 0.85rem; font-size: 0.82rem; font-weight: 800; border: none; border-radius: 50px;" onclick="startCrossword('medium')">Medium</button>
          <button id="cw-btn-hard" class="btn btn-outline btn-compact" style="padding: 0.3rem 0.85rem; font-size: 0.82rem; font-weight: 800; border: none; border-radius: 50px;" onclick="startCrossword('hard')">Hard</button>
        </div>
        <button class="btn btn-outline btn-compact" onclick="giveCrosswordHint()" style="border-radius: 50px; font-weight: 700; border: 1.5px solid #000000;">
          💡 Hint
        </button>
        <button class="btn btn-outline btn-compact" onclick="startCrossword(window.cwCurrentDifficulty || 'easy')" style="border-radius: 50px; font-weight: 700; border: 1.5px solid #000000;">
          ⏭ Next
        </button>
        <a href="/" class="btn btn-outline btn-compact" style="border-radius: 50px; font-weight: 700; border: 1.5px solid #000000;">
          &larr; Exit
        </a>
      </div>
    </header>

    <!-- Loading Screen -->
    <div id="crossword-loading-screen" style="flex-grow: 1; display: none; flex-direction: column; align-items: center; justify-content: center; background: #ffffff; padding: 2rem;">
        <div class="loader" style="width: 44px; height: 44px; border: 4px solid #f3f3f3; border-top: 4px solid #7c3aed; border-radius: 50%; animation: spin 1s linear infinite;"></div>
        <h3 style="margin-top: 1rem; color: #000000; font-size: 1.3rem; font-weight: 900;">Generating Crossword Puzzle...</h3>
        <p style="color: #64748b; font-weight: 600;">Crafting clues with AI...</p>
    </div>

    <!-- Game Screen (Top Aligned Split View) -->
    <div id="crossword-game-screen" style="flex-grow: 1; display: none; flex-direction: row; overflow: hidden; background: #ffffff;">
        
        <!-- Clues Sidebar -->
        <div style="flex: 0 0 320px; border-right: 2px solid #000000; display: flex; flex-direction: column; background: #f8fafc;">
            <div style="padding: 0.75rem 1rem; border-bottom: 2px solid #000000; background: #ede9fe;">
                <h4 style="margin: 0; color: #5b21b6; font-size: 0.95rem; font-weight: 900;">Across &amp; Down Clues</h4>
            </div>
            <div id="crossword-clues-container" style="flex-grow: 1; overflow-y: auto; padding: 1rem;">
                <!-- Clues will be injected here -->
            </div>
        </div>

        <!-- Board Area (Top Aligned) -->
        <div style="flex-grow: 1; display: flex; align-items: flex-start; justify-content: center; overflow: auto; padding: 1.5rem; background: #ffffff;">
            <div id="crossword-board" style="position: relative; border: none; background: transparent; gap: 6px;">
                <!-- Grid squares will be injected here -->
            </div>
        </div>

    </div>

    <!-- End Screen -->
    <div id="crossword-end-screen" style="padding: 2.5rem 1.5rem; flex-grow: 1; display: none; flex-direction: column; align-items: center; justify-content: center; background: #ffffff; text-align: center;">
        <span style="font-size: 4.5rem; display: block; margin-bottom: 0.5rem;">🎉</span>
        <h3 style="font-size: 2.2rem; font-weight: 900; color: #000000; margin: 0 0 0.5rem 0;">Puzzle Complete!</h3>
        <p style="font-size: 1.1rem; color: #475569; font-weight: 600; margin: 0 0 1.5rem 0;">You've mastered this crossword challenge!</p>
        <div style="display: flex; gap: 1rem;">
            <button class="btn btn-primary" style="padding: 0.6rem 1.75rem; border-radius: 50px; font-size: 0.95rem; font-weight: 800; border: 2px solid #000000; box-shadow: 2px 2px 0px #000000;" onclick="startCrossword(window.cwState.currentDifficulty)">Play Next Puzzle</button>
            <a href="/" class="btn btn-outline" style="padding: 0.6rem 1.75rem; border-radius: 50px; font-size: 0.95rem; font-weight: 800; border: 2px solid #000000; box-shadow: 2px 2px 0px #000000;">Dashboard</a>
        </div>
    </div>
    
  </div>
</main>

<script>
    (function() {
        const init = () => {
            if (document.getElementById('crossword-game-screen')) {
                if (typeof startCrossword === 'function') {
                    startCrossword('easy');
                } else {
                    setTimeout(() => {
                        if (typeof startCrossword === 'function') startCrossword('easy');
                    }, 100);
                }
            }
        };
        document.addEventListener("turbo:load", init);
        if (document.readyState === "complete" || document.readyState === "interactive") {
            init();
        } else {
            document.addEventListener("DOMContentLoaded", init);
        }
    })();
</script>
