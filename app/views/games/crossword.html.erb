<main class="app-content">
  <div style="display: flex; flex-direction: column; height: 100%; background: var(--color-bg); border-radius: 16px; overflow: hidden; box-shadow: 0 4px 20px rgba(0,0,0,0.05);">
    
    <!-- Header -->
    <div style="padding: 1.5rem 2rem; border-bottom: 1px solid var(--color-border); display: flex; justify-content: space-between; align-items: center; background: var(--color-surface);">
        <div>
            <h2 style="font-size: 1.8rem; font-weight: 700; color: var(--color-text-main); margin: 0; display: flex; align-items: center; gap: 0.5rem;">
                <span style="font-size: 2rem;">📝</span> Crossword
            </h2>
        </div>
        <div style="display: flex; gap: 0.5rem; align-items: center;">
            <div style="display: flex; background: var(--color-bg); border-radius: 8px; padding: 4px; border: 1px solid var(--color-border);">
                <button id="cw-btn-easy" class="btn" style="padding: 0.4rem 1rem; font-size: 0.9rem;" onclick="startCrossword('easy')">Easy</button>
                <button id="cw-btn-medium" class="btn btn-outline" style="padding: 0.4rem 1rem; font-size: 0.9rem; border: none;" onclick="startCrossword('medium')">Medium</button>
                <button id="cw-btn-hard" class="btn btn-outline" style="padding: 0.4rem 1rem; font-size: 0.9rem; border: none;" onclick="startCrossword('hard')">Hard</button>
            </div>
            <button class="btn btn-primary" onclick="giveCrosswordHint()" style="margin-left: 0.5rem; padding: 0.4rem 1rem; font-size: 0.9rem;">
                💡 Hint
            </button>
            <button class="btn btn-outline" onclick="startCrossword(window.cwCurrentDifficulty || 'easy')" style="margin-left: 0.5rem; padding: 0.4rem 1rem; font-size: 0.9rem;">
                ⏭ Next
            </button>
        </div>
    </div>

    <!-- Loading Screen -->
    <div id="crossword-loading-screen" style="flex-grow: 1; display: none; flex-direction: column; align-items: center; justify-content: center; background: var(--color-bg);">
        <div class="loader" style="width: 50px; height: 50px; border: 4px solid var(--color-border); border-top-color: var(--color-primary); border-radius: 50%; animation: spin 1s linear infinite;"></div>
        <h3 style="margin-top: 1.5rem; color: var(--color-text-main);">Generating Puzzle...</h3>
        <p style="color: var(--color-text-muted);">Crafting clues with AI...</p>
    </div>

    <!-- Game Screen -->
    <div id="crossword-game-screen" style="flex-grow: 1; display: none; flex-direction: row; overflow: hidden; background: var(--color-bg);">
        
        <!-- Clues Sidebar -->
        <div style="flex: 0 0 300px; border-right: 1px solid var(--color-border); display: flex; flex-direction: column; background: var(--color-surface);">
            <div style="padding: 1rem; border-bottom: 1px solid var(--color-border); background: var(--color-bg);">
                <h4 style="margin: 0; color: var(--color-text-main);">Across & Down</h4>
            </div>
            <div id="crossword-clues-container" style="flex-grow: 1; overflow-y: auto; padding: 1rem;">
                <!-- Clues will be injected here -->
            </div>
        </div>

        <!-- Board Area -->
        <div style="flex-grow: 1; display: flex; align-items: center; justify-content: center; overflow: auto; padding: 2rem; background: var(--color-bg);">
            <div id="crossword-board" style="position: relative; border: none; background: transparent; gap: 6px;">
                <!-- Grid squares will be injected here -->
            </div>
        </div>

    </div>

    <!-- End Screen -->
    <div id="crossword-end-screen" style="padding: 4rem 2rem; flex-grow: 1; display: none; flex-direction: column; align-items: center; justify-content: center; background: var(--color-bg); text-align: center;">
        <span style="font-size: 5rem; display: block; margin-bottom: 1rem;">🎉</span>
        <h3 style="font-size: 2.5rem; color: var(--color-text-main); margin: 0 0 1rem 0;">Puzzle Complete!</h3>
        <p style="font-size: 1.2rem; color: var(--color-text-muted); margin: 0 0 2rem 0;">You've mastered this crossword!</p>
        <div style="display: flex; gap: 1rem;">
            <button class="btn btn-outline" onclick="startCrossword(window.cwState.currentDifficulty)">Play Again</button>
            <a href="/" class="btn btn-primary">Exit</a>
        </div>
    </div>
    
  </div>
</main>

<script>
    document.addEventListener("DOMContentLoaded", () => {
        // Automatically start the crossword on this page load
        if (typeof startCrossword === 'function') {
            startCrossword('easy');
        } else {
            // Wait slightly if js takes a moment to load
            setTimeout(() => {
                if (typeof startCrossword === 'function') startCrossword('easy');
            }, 100);
        }
    });
</script>
