<main class="app-content" style="padding: 1rem 1.5rem; height: calc(100vh - 70px); box-sizing: border-box; display: flex; flex-direction: column;">
  <div style="display: flex; flex-direction: column; height: 100%; background: #ffffff; border: 2px solid #000000; border-radius: 14px; overflow: hidden; box-shadow: var(--shadow-relief-md);">
    
    <!-- Header -->
    <header style="padding: 0.65rem 1.5rem; border-bottom: 2px solid #000000; display: flex; justify-content: space-between; align-items: center; background: #ffffff; flex-shrink: 0; gap: 1rem;">
      <div style="display: flex; align-items: center; gap: 0.75rem;">
        <span style="font-size: 1.6rem; background: #ede9fe; padding: 0.2rem 0.45rem; border-radius: 8px; border: 1.5px solid #000000; box-shadow: 1.5px 1.5px 0px #000000;">📖</span>
        <div>
          <h2 style="font-size: 1.35rem; font-weight: 900; color: #000000; margin: 0; line-height: 1.2;">
            Create a Story
          </h2>
          <span style="color: var(--color-text-muted); font-size: 0.8rem; font-weight: 600;">
            Take turns writing sentences. The full story is revealed at the end!
          </span>
        </div>
      </div>
      <div style="display: flex; gap: 0.75rem; align-items: center;">
        <div style="display: flex; background: #f8fafc; border-radius: 50px; padding: 0.2rem; border: 2px solid #000000; box-shadow: 2px 2px 0px #000000;">
          <button id="mode-btn-computer" onclick="window.setStoryMode('computer')" style="padding: 0.35rem 1rem; border-radius: 50px; border: 1px solid #000000; background: #7c3aed; color: white; font-weight: 800; cursor: pointer; font-size: 0.85rem;">🤖 vs Computer</button>
          <button id="mode-btn-friend" onclick="window.setStoryMode('friend')" style="padding: 0.35rem 1rem; border-radius: 50px; border: none; background: transparent; color: #475569; font-weight: 800; cursor: pointer; font-size: 0.85rem;">👤 vs Friend</button>
        </div>
        <a href="/" class="btn btn-outline btn-compact" style="border-radius: 50px; font-weight: 700; border: 1.5px solid #000000;">
          &larr; Exit
        </a>
      </div>
    </header>

    <!-- Game Container (Top Aligned) -->
    <div style="flex: 1; padding: 1.25rem 1.5rem; display: flex; flex-direction: column; align-items: center; justify-content: flex-start; position: relative; overflow-y: auto;">
        
        <!-- Setup Screen -->
        <div id="story-setup-screen" style="max-width: 650px; width: 100%; text-align: center;">
            <div id="story-prompts-loading" style="display: none; margin-top: 1.5rem; font-size: 2.5rem; animation: pulse 1.5s infinite;">⏳</div>
            
            <div id="story-prompts-container" style="display: none; margin-top: 0.5rem; text-align: left;">
                <h4 style="color: #000000; font-size: 1.1rem; font-weight: 900; margin-bottom: 0.75rem;">Choose a phrase to begin your story:</h4>
                <div id="story-prompts-list" style="display: flex; flex-direction: column; gap: 0.75rem;">
                    <!-- Injected prompts -->
                </div>
            </div>
        </div>

        <!-- Gameplay Screen -->
        <div id="story-game-screen" style="display: none; max-width: 650px; width: 100%; flex-direction: column; align-items: center;">
            <div id="story-turn-indicator" style="font-size: 1.1rem; font-weight: 900; color: #5b21b6; margin-bottom: 0.75rem; background: #ede9fe; border: 1.5px solid #000000; padding: 0.35rem 1.5rem; border-radius: 50px; box-shadow: 2px 2px 0px #000000;">
                Your Turn
            </div>
            
            <p style="color: #475569; font-size: 0.95rem; font-weight: 600; margin: 0 0 1rem 0; text-align: center;">Write one sentence to continue the story narrative.</p>
            
            <div id="story-computer-thinking" style="display: none; align-items: center; gap: 0.75rem; background: #f8fafc; border: 2px solid #000000; padding: 1rem; border-radius: 10px; width: 100%; justify-content: center; margin-bottom: 1rem; box-shadow: 2px 2px 0px #000000;">
                <span style="font-size: 1.5rem; animation: spin 2s linear infinite;">⌛</span>
                <span style="font-size: 1.05rem; color: #000000; font-weight: 800;">Computer is writing...</span>
            </div>
            
            <div id="story-input-area" style="width: 100%; display: flex; flex-direction: column; gap: 0.75rem;">
                <textarea id="story-input" class="text-input" rows="3" placeholder="Write your sentence here..." style="font-size: 1.05rem; font-weight: 600; padding: 1rem; resize: vertical; border-radius: 10px; border: 2px solid #000000; background: #f8fafc; box-shadow: 2px 2px 0px #000000;"></textarea>
                <button class="btn btn-primary" onclick="submitStoryTurn()" style="padding: 0.75rem; border-radius: 50px; font-size: 1rem; font-weight: 800; border: 2px solid #000000; box-shadow: 2px 2px 0px #000000;">Submit &amp; Pass Turn</button>
            </div>
            
            <hr style="width: 100%; border: none; border-top: 1.5px solid #e2e8f0; margin: 1.25rem 0;">
            
            <button class="btn btn-outline" onclick="endStoryGame()" style="padding: 0.5rem 1.5rem; border-radius: 50px; font-size: 0.9rem; font-weight: 800; color: #dc2626; border: 1.5px solid #000000; background: #fee2e2; box-shadow: 2px 2px 0px #000000;">End Game &amp; Reveal Story</button>
        </div>

        <!-- Reveal Screen -->
        <div id="story-reveal-screen" style="display: none; max-width: 650px; width: 100%; flex-direction: column; align-items: center;">
            <div style="font-size: 3.5rem; margin-bottom: 0.5rem;">📜</div>
            <h3 style="font-size: 1.8rem; font-weight: 900; color: #000000; margin-bottom: 1rem;">The Complete Story</h3>
            
            <div id="story-full-text" style="width: 100%; background: #f8fafc; border: 2px solid #000000; padding: 1.5rem; border-radius: 12px; font-size: 1.15rem; font-weight: 600; line-height: 1.7; color: #000000; box-shadow: var(--shadow-relief-md); margin-bottom: 1.5rem; white-space: pre-wrap;">
                <!-- Full story injected here -->
            </div>
            
            <div style="display: flex; gap: 1rem; justify-content: center;">
                <a href="/" class="btn btn-outline" style="padding: 0.6rem 1.75rem; border-radius: 50px; font-size: 0.95rem; font-weight: 800; border: 2px solid #000000; box-shadow: 2px 2px 0px #000000;">Dashboard</a>
                <button class="btn btn-primary" onclick="initCreateStoryPage()" style="padding: 0.6rem 1.75rem; border-radius: 50px; font-size: 0.95rem; font-weight: 800; border: 2px solid #000000; box-shadow: 2px 2px 0px #000000;">Write Another Story</button>
            </div>
        </div>

    </div>
  </div>
</main>

<style>
.story-prompt-btn {
    width: 100%;
    text-align: left;
    padding: 1rem 1.25rem;
    background: #ffffff;
    border: 2px solid #000000;
    border-radius: 10px;
    font-size: 1rem;
    font-weight: 700;
    color: #000000;
    cursor: pointer;
    transition: all 0.15s;
    line-height: 1.4;
    box-shadow: 2px 2px 0px #000000;
}

.story-prompt-btn:hover {
    background: #ede9fe;
    transform: translateY(-1px);
    box-shadow: 3px 3px 0px #000000;
}
</style>

<script>
    if (typeof initCreateStoryPage === 'function') {
        initCreateStoryPage();
    } else {
        setTimeout(() => {
            if (typeof initCreateStoryPage === 'function') initCreateStoryPage();
        }, 100);
    }
</script>
