<main class="app-content" style="padding: 1rem 1.5rem; height: calc(100vh - 70px); box-sizing: border-box; display: flex; flex-direction: column;">
  <div style="display: flex; flex-direction: column; height: 100%; background: #ffffff; border: 2px solid #000000; border-radius: 14px; overflow: hidden; box-shadow: var(--shadow-relief-md);">
    
    <!-- Header -->
    <header style="padding: 0.65rem 1.5rem; border-bottom: 2px solid #000000; display: flex; justify-content: space-between; align-items: center; background: #ffffff; flex-shrink: 0; gap: 1rem;">
      <div style="display: flex; align-items: center; gap: 0.75rem;">
        <span style="font-size: 1.6rem; background: #ede9fe; padding: 0.2rem 0.45rem; border-radius: 8px; border: 1.5px solid #000000; box-shadow: 1.5px 1.5px 0px #000000;">🧠</span>
        <div>
          <h2 style="font-size: 1.35rem; font-weight: 900; color: #000000; margin: 0; line-height: 1.2;">
            Brain Stretch (Critical Thinking)
          </h2>
          <span style="color: var(--color-text-muted); font-size: 0.8rem; font-weight: 600;">
            Train your brain with personalized logic &amp; pattern challenges
          </span>
        </div>
      </div>
      <div style="display: flex; gap: 0.75rem; align-items: center;">
        <div style="display: flex; align-items: center; gap: 0.35rem;">
          <label for="ct-difficulty-select" style="font-weight: 800; font-size: 0.82rem; color: #000000;">Level:</label>
          <select id="ct-difficulty-select" onchange="changeCriticalThinkingDifficulty(this.value)" class="difficulty-dropdown">
            <option value="easy" <%= 'selected' if @difficulty == 'easy' %>>Easy</option>
            <option value="medium" <%= 'selected' if @difficulty == 'medium' %>>Medium</option>
            <option value="hard" <%= 'selected' if @difficulty == 'hard' %>>Hard</option>
            <option value="genius" <%= 'selected' if @difficulty == 'genius' %>>Genius</option>
          </select>
        </div>
        <a href="/" class="btn btn-outline btn-compact" style="border-radius: 50px; font-weight: 700; border: 1.5px solid #000000;">
          &larr; Exit
        </a>
      </div>
    </header>

    <!-- Game Container (Top Aligned) -->
    <div style="flex: 1; padding: 1.25rem 1.5rem; display: flex; flex-direction: column; align-items: center; justify-content: flex-start; position: relative; overflow-y: auto;">
        
        <!-- Loading State -->
        <div id="ct-loading" style="display: <%= @game_data.present? ? 'none' : 'block' %>; text-align: center; margin-top: 1.5rem;">
            <div style="font-size: 2.5rem; animation: pulse 1.5s infinite;">⏳</div>
            <h3 style="color: #000000; font-size: 1.35rem; font-weight: 900; margin-top: 1rem;">Generating your puzzles...</h3>
            <p style="color: #64748b; font-weight: 600;">Please wait a moment while the AI designs challenges.</p>
        </div>

        <!-- Gameplay Area -->
        <div id="ct-game-container" style="display: <%= @game_data.present? ? 'flex' : 'none' %>; width: 100%; max-width: 750px; flex-direction: column; align-items: center;" data-rounds="<%= @game_data ? @game_data['rounds'].to_json : '' %>">
            
            <div style="width: 100%; display: flex; justify-content: space-between; align-items: center; margin-bottom: 0.75rem;">
                <span id="ct-round-indicator" style="font-size: 0.95rem; font-weight: 800; color: #5b21b6; background: #ede9fe; border: 1px solid #000000; padding: 0.2rem 0.75rem; border-radius: 50px;">Round 1 of 3</span>
            </div>
            
            <!-- Question Box -->
            <div style="width: 100%; background: #f8fafc; padding: 1.5rem; border-radius: 12px; margin-bottom: 1.25rem; box-shadow: 2px 2px 0px #000000; border: 2px solid #000000; text-align: center; box-sizing: border-box;">
                <h3 id="ct-question-text" style="font-size: 1.35rem; color: #000000; font-weight: 800; margin: 0; line-height: 1.5;">Question loads here</h3>
            </div>
            
            <!-- Options Box -->
            <div id="ct-options" style="display: grid; grid-template-columns: 1fr 1fr; gap: 0.75rem; width: 100%;">
                <!-- Options injected here -->
            </div>
            
            <!-- Feedback -->
            <div id="ct-feedback" style="display: none; margin-top: 1.25rem; padding: 0.85rem; border-radius: 10px; width: 100%; text-align: center; font-weight: 800; font-size: 1.1rem; border: 2px solid #000000; box-sizing: border-box;">
                <!-- Feedback injected here -->
            </div>
            
        </div>
        
        <!-- End Screen -->
        <div id="ct-end-screen" style="display: none; text-align: center; flex-direction: column; align-items: center; margin-top: 1.5rem;">
            <div style="font-size: 4rem; margin-bottom: 0.5rem;">🎓</div>
            <h2 style="font-size: 2.2rem; font-weight: 900; color: #000000; margin-bottom: 0.5rem;">Brain Stretch Complete!</h2>
            <p id="ct-score-text" style="font-size: 1.15rem; font-weight: 700; color: #475569; margin-bottom: 1.5rem;">You scored X out of Y.</p>
            <div style="display: flex; gap: 1rem;">
                <a href="/" class="btn btn-outline" style="padding: 0.6rem 1.75rem; border-radius: 50px; font-size: 0.95rem; font-weight: 800; border: 2px solid #000000; box-shadow: 2px 2px 0px #000000;">Dashboard</a>
                <button class="btn btn-primary" onclick="initCriticalThinkingPage()" style="padding: 0.6rem 1.75rem; border-radius: 50px; font-size: 0.95rem; font-weight: 800; border: 2px solid #000000; box-shadow: 2px 2px 0px #000000;">Play Again</button>
            </div>
        </div>

    </div>
  </div>
</main>

<style>
.ct-option-btn {
    padding: 1.15rem;
    font-size: 1.1rem;
    font-weight: 800;
    border-radius: 10px;
    border: 2px solid #000000;
    background: #ffffff;
    color: #000000;
    cursor: pointer;
    box-shadow: 2px 2px 0px #000000;
    transition: all 0.15s ease;
}

.ct-option-btn:hover:not(:disabled) {
    background: #ede9fe;
    transform: translateY(-1px);
    box-shadow: 3px 3px 0px #000000;
}

.ct-option-btn.correct {
    background: #dcfce7 !important;
    color: #065f46 !important;
}

.ct-option-btn.incorrect {
    background: #fee2e2 !important;
    color: #991b1b !important;
}
</style>

<script>
    if (typeof initCriticalThinkingPage === 'function') {
        initCriticalThinkingPage();
    } else {
        setTimeout(() => {
            if (typeof initCriticalThinkingPage === 'function') initCriticalThinkingPage();
        }, 100);
    }
</script>
