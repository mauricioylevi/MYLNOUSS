<main class="app-content">
  <div style="display: flex; flex-direction: column; height: 100%; background: var(--color-bg); border-radius: 16px; overflow: hidden; box-shadow: 0 4px 20px rgba(0,0,0,0.05);">
    
    <!-- Header -->
    <div style="padding: 1.5rem 2rem; border-bottom: 1px solid var(--color-border); display: flex; justify-content: space-between; align-items: center; background: var(--color-surface);">
        <div>
            <h2 style="font-size: 1.8rem; font-weight: 700; color: var(--color-text-main); margin: 0; display: flex; align-items: center; gap: 0.5rem;">
                <span style="font-size: 2rem;">🧠</span> Critical Thinking
            </h2>
            <p style="color: var(--color-text-muted); margin: 0.25rem 0 0 0; font-size: 0.95rem;">Train your brain with personalized logic & math puzzles</p>
        </div>
        <div style="display: flex; gap: 1rem; align-items: center;">
            <select id="ct-difficulty-select" onchange="changeCriticalThinkingDifficulty(this.value)" style="padding: 0.5rem 1rem; border-radius: 50px; border: 1px solid var(--color-border); background: var(--color-bg); color: var(--color-text-main); font-size: 0.95rem; font-weight: 600; cursor: pointer; outline: none; box-shadow: var(--shadow-sm);">
                <option value="easy" <%= 'selected' if @difficulty == 'easy' %>>Easy</option>
                <option value="medium" <%= 'selected' if @difficulty == 'medium' %>>Medium</option>
                <option value="hard" <%= 'selected' if @difficulty == 'hard' %>>Hard</option>
                <option value="genius" <%= 'selected' if @difficulty == 'genius' %>>Genius</option>
            </select>
            <a href="/" class="btn btn-outline" style="border-radius: 50px; padding: 0.4rem 1rem; font-size: 0.9rem;">&larr; Back to Dashboard</a>
        </div>
    </div>

    <!-- Game Container -->
    <div style="flex: 1; padding: 2rem; display: flex; flex-direction: column; align-items: center; justify-content: center; position: relative; overflow-y: auto;">
        
        <!-- Loading State -->
        <div id="ct-loading" style="display: <%= @game_data.present? ? 'none' : 'block' %>; text-align: center; margin-top: 2rem;">
            <div style="font-size: 2.5rem; animation: pulse 1.5s infinite;">⏳</div>
            <h3 style="color: var(--color-text-main); margin-top: 1rem;">Generating your puzzles...</h3>
            <p style="color: var(--color-text-muted);">Please wait a moment while the AI thinks.</p>
        </div>

        <!-- Gameplay Area -->
        <div id="ct-game-container" style="display: <%= @game_data.present? ? 'flex' : 'none' %>; width: 100%; max-width: 700px; flex-direction: column; align-items: center;" data-rounds="<%= @game_data ? @game_data['rounds'].to_json : '' %>">
            
            <div id="ct-round-indicator" style="font-size: 1rem; font-weight: 600; color: var(--color-text-muted); margin-bottom: 1rem; text-transform: uppercase; letter-spacing: 1px;">Round 1 / 3</div>
            
            <!-- Question Box -->
            <div style="width: 100%; background: var(--color-surface); padding: 2rem; border-radius: 12px; margin-bottom: 2rem; box-shadow: 0 4px 15px rgba(0,0,0,0.05); border: 1px solid var(--color-border); text-align: center;">
                <h3 id="ct-question-text" style="font-size: 1.4rem; color: var(--color-text-main); margin: 0; line-height: 1.5;">Question loads here</h3>
            </div>
            
            <!-- Options Box -->
            <div id="ct-options" style="display: grid; grid-template-columns: 1fr 1fr; gap: 1rem; width: 100%;">
                <!-- Options injected here -->
            </div>
            
            <!-- Feedback -->
            <div id="ct-feedback" style="display: none; margin-top: 1.5rem; padding: 1rem; border-radius: 12px; width: 100%; text-align: center; font-weight: 700; font-size: 1.2rem;">
                <!-- Feedback injected here -->
            </div>
            
        </div>
        
        <!-- End Screen -->
        <div id="ct-end-screen" style="display: none; text-align: center; flex-direction: column; align-items: center;">
            <div style="font-size: 4rem; margin-bottom: 1rem;">🎓</div>
            <h2 style="font-size: 2.2rem; color: var(--color-text-main); margin-bottom: 1rem;">Thinking Complete!</h2>
            <p id="ct-score-text" style="font-size: 1.2rem; color: var(--color-text-muted); margin-bottom: 2rem;">You scored X out of Y.</p>
            <div style="display: flex; gap: 1rem;">
                <button class="btn btn-primary" onclick="window.location.reload()" style="padding: 0.75rem 2rem; border-radius: 50px; font-size: 1.1rem; box-shadow: 0 4px 15px rgba(99, 102, 241, 0.4);">Play Again</button>
                <a href="/" class="btn btn-outline" style="padding: 0.75rem 2rem; border-radius: 50px; font-size: 1.1rem; color: #DC2626; border-color: #fca5a5; background: #fef2f2;">Exit to Dashboard</a>
            </div>
        </div>

    </div>
  </div>
</main>

<style>
.ct-option-btn {
    background: var(--color-surface);
    border: 2px solid var(--color-border);
    padding: 1.25rem 1.5rem;
    border-radius: 12px;
    font-size: 1.1rem;
    color: var(--color-text-main);
    cursor: pointer;
    transition: all 0.2s;
    text-align: center;
    font-weight: 600;
    box-shadow: 0 2px 5px rgba(0,0,0,0.02);
}
.ct-option-btn:hover {
    border-color: var(--color-primary);
    background: rgba(99, 102, 241, 0.05);
    transform: translateY(-2px);
}
.ct-option-btn.correct {
    background: #d1fae5;
    border-color: #10b981;
    color: #065f46;
}
.ct-option-btn.wrong {
    background: #fee2e2;
    border-color: #ef4444;
    color: #991b1b;
}
</style>

<script>
    if (typeof initCriticalThinkingPage === 'function') {
        initCriticalThinkingPage();
    } else {
        setTimeout(() => {
            if (typeof initCriticalThinkingPage === 'function') initCriticalThinkingPage();
        }, 100);
    }
</script>
