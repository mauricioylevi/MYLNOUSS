<main class="app-content" style="padding: 1rem 1.5rem; height: calc(100vh - 70px); box-sizing: border-box; display: flex; flex-direction: column;">
  <div style="display: flex; flex-direction: column; height: 100%; background: #ffffff; border: 2px solid #000000; border-radius: 14px; overflow: hidden; box-shadow: var(--shadow-relief-md);">
    
    <!-- Header -->
    <header style="padding: 0.65rem 1.5rem; border-bottom: 2px solid #000000; display: flex; justify-content: space-between; align-items: center; background: #ffffff; flex-shrink: 0; gap: 1rem;">
      <div style="display: flex; align-items: center; gap: 0.75rem;">
        <span style="font-size: 1.6rem; background: #ede9fe; padding: 0.2rem 0.45rem; border-radius: 8px; border: 1.5px solid #000000; box-shadow: 1.5px 1.5px 0px #000000;">💬</span>
        <div>
          <h2 style="font-size: 1.35rem; font-weight: 900; color: #000000; margin: 0; line-height: 1.2;">
            Let's Talk!
          </h2>
          <span style="color: var(--color-text-muted); font-size: 0.8rem; font-weight: 600;">
            Meaningful conversation topics tailored to your life story & passions
          </span>
        </div>
      </div>
      <div style="display: flex; gap: 0.5rem; align-items: center;">
        <a href="/" class="btn btn-outline btn-compact" style="border-radius: 50px; font-weight: 700; border: 1.5px solid #000000;">
          &larr; Exit
        </a>
      </div>
    </header>

    <!-- Game Container (Top Aligned) -->
    <div style="flex: 1; padding: 1.5rem; display: flex; flex-direction: column; align-items: center; justify-content: flex-start; position: relative; overflow-y: auto;">
        
        <% if @game_data.nil? || @game_data['prompts'].empty? %>
            <div style="text-align: center; margin-top: 2rem;">
                <div style="font-size: 3rem; animation: pulse 1.5s infinite;">⏳</div>
                <h3 style="color: #000000; font-size: 1.35rem; font-weight: 900; margin-top: 1rem;">Generating conversation topics...</h3>
                <p style="color: #64748b; font-weight: 600;">Crafting questions with AI. Please wait a moment.</p>
            </div>
        <% else %>
            <div id="lt-container" data-prompts="<%= @game_data['prompts'].to_json %>" style="width: 100%; max-width: 750px; display: flex; flex-direction: column; align-items: center;">
                
                <div style="width: 100%; display: flex; justify-content: space-between; align-items: center; margin-bottom: 1rem;">
                    <span id="lt-round-indicator" style="font-size: 0.95rem; font-weight: 800; color: #5b21b6; background: #ede9fe; border: 1px solid #000000; padding: 0.2rem 0.75rem; border-radius: 50px;">Topic 1 of 3</span>
                </div>
                
                <!-- Prompt Box -->
                <div style="width: 100%; background: #f8fafc; padding: 2.5rem 2rem; border-radius: 14px; margin-bottom: 1.5rem; box-shadow: var(--shadow-relief-md); border: 2px solid #000000; text-align: center; box-sizing: border-box;">
                    <span style="font-size: 2rem; display: block; margin-bottom: 0.75rem;">💭</span>
                    <h3 id="lt-prompt-text" style="font-size: 1.5rem; font-weight: 800; color: #000000; margin: 0; line-height: 1.5;">
                        "Loading..."
                    </h3>
                </div>
                
                <!-- Controls -->
                <div style="display: flex; gap: 1rem; width: 100%; justify-content: center;">
                    <button class="btn btn-primary" onclick="nextLetsTalkPrompt()" style="padding: 0.75rem 2.5rem; border-radius: 50px; font-size: 1.05rem; font-weight: 800; border: 2px solid #000000; box-shadow: 2px 2px 0px #000000;">
                        Next Topic &rarr;
                    </button>
                </div>
                
            </div>

            <!-- End Screen -->
            <div id="lt-end-screen" style="display: none; text-align: center; flex-direction: column; align-items: center; margin-top: 1.5rem;">
                <div style="font-size: 4.5rem; margin-bottom: 0.5rem;">☕</div>
                <h2 style="font-size: 2.2rem; font-weight: 900; color: #000000; margin-bottom: 0.5rem;">Great Conversation!</h2>
                <p style="font-size: 1.1rem; color: #475569; font-weight: 600; margin-bottom: 1.5rem;">It was wonderful reflecting on your life experiences and memories.</p>
                <div style="display: flex; gap: 1rem;">
                    <a href="/" class="btn btn-outline" style="padding: 0.6rem 1.75rem; border-radius: 50px; font-size: 0.95rem; font-weight: 800; border: 2px solid #000000; box-shadow: 2px 2px 0px #000000;">Return to Dashboard</a>
                    <a href="/games/lets_talk" class="btn btn-primary" style="padding: 0.6rem 1.75rem; border-radius: 50px; font-size: 0.95rem; font-weight: 800; border: 2px solid #000000; box-shadow: 2px 2px 0px #000000;">More Topics</a>
                </div>
            </div>
        <% end %>

    </div>
  </div>
</main>
