<main class="app-content" style="padding: 1rem 1.5rem; height: calc(100vh - 70px); box-sizing: border-box; display: flex; flex-direction: column;">
  <div style="display: flex; flex-direction: column; height: 100%; background: #ffffff; border: 2px solid #000000; border-radius: 14px; overflow: hidden; box-shadow: var(--shadow-relief-md);">
    
    <!-- Header -->
    <header style="padding: 0.65rem 1.5rem; border-bottom: 2px solid #000000; display: flex; justify-content: space-between; align-items: center; background: #ffffff; flex-shrink: 0; gap: 1rem;">
      <div style="display: flex; align-items: center; gap: 0.75rem;">
        <span style="font-size: 1.6rem; background: #ede9fe; padding: 0.2rem 0.45rem; border-radius: 8px; border: 1.5px solid #000000; box-shadow: 1.5px 1.5px 0px #000000;">🔍</span>
        <div>
          <h2 style="font-size: 1.35rem; font-weight: 900; color: #000000; margin: 0; line-height: 1.2;">
            Word Search
          </h2>
          <span style="color: var(--color-text-muted); font-size: 0.8rem; font-weight: 600;">
            Find hidden words &bull; Tap first letter then last letter to highlight
          </span>
        </div>
      </div>
      <div style="display: flex; gap: 0.75rem; align-items: center;">
        <div style="display: flex; align-items: center; gap: 0.35rem;">
          <label for="word-search-difficulty" style="font-weight: 800; font-size: 0.82rem; color: #000000;">Level:</label>
          <select id="word-search-difficulty" onchange="window.location.href='/games/word_search?difficulty=' + this.value" class="difficulty-dropdown">
            <option value="easy" <%= @difficulty == 'easy' ? 'selected' : '' %>>Easy (10x10)</option>
            <option value="medium" <%= @difficulty == 'medium' ? 'selected' : '' %>>Medium (15x15)</option>
            <option value="hard" <%= @difficulty == 'hard' ? 'selected' : '' %>>Hard (20x20)</option>
          </select>
        </div>
        <a href="/" class="btn btn-outline btn-compact" style="border-radius: 50px; font-weight: 700; border: 1.5px solid #000000;">
          &larr; Exit
        </a>
      </div>
    </header>

    <!-- Game Container (Top Aligned) -->
    <div style="flex: 1; padding: 1.25rem 1.5rem; display: flex; justify-content: center; align-items: flex-start; position: relative; overflow-y: auto;">
        
        <% if @words.nil? || @words.empty? %>
            <div style="text-align: center; margin-top: 2rem;">
                <div style="font-size: 2.5rem; animation: pulse 1.5s infinite;">⏳</div>
                <h3 style="color: #000000; font-size: 1.35rem; font-weight: 900; margin-top: 1rem;">Generating your puzzle...</h3>
                <p style="color: #64748b; font-weight: 600;">Analyzing your profile to build custom words. Please wait a few seconds!</p>
            </div>
            <script>
                setTimeout(() => window.location.reload(), 3000);
            </script>
        <% else %>
            <div id="word-search-container" style="max-width: 1000px; width: 100%; display: grid; grid-template-columns: 1fr 280px; gap: 1.5rem; align-items: start;" data-words="<%= @words.to_json %>" data-difficulty="<%= @difficulty %>">
                
                <!-- Grid Area (Top Aligned) -->
                <div style="display: flex; justify-content: center; align-items: flex-start;">
                    <div id="word-search-grid" style="background: #f8fafc; padding: 1rem; border-radius: 14px; border: 2px solid #000000; box-shadow: var(--shadow-relief-md); display: inline-grid; gap: 3px; user-select: none;">
                        <!-- JS injected grid cells -->
                    </div>
                </div>

                <!-- Word List Area -->
                <div style="background: #ffffff; padding: 1.25rem; border-radius: 14px; border: 2px solid #000000; box-shadow: var(--shadow-relief-md); height: fit-content; max-height: 100%;">
                    <div style="display: flex; align-items: center; gap: 0.5rem; margin-bottom: 0.75rem; border-bottom: 2px solid #f1f5f9; padding-bottom: 0.5rem;">
                      <span style="font-size: 1.2rem;">📋</span>
                      <h3 style="font-size: 1.1rem; font-weight: 900; color: #000000; margin: 0;">Words to Find</h3>
                    </div>
                    <div id="word-search-list" style="display: flex; flex-direction: column; gap: 0.4rem; overflow-y: auto; max-height: 400px;">
                        <!-- JS injected words -->
                    </div>
                </div>

            </div>

            <!-- End Screen -->
            <div id="word-search-end-screen" style="display: none; flex-direction: column; align-items: center; text-align: center; position: absolute; inset: 0; background: rgba(255,255,255,0.95); justify-content: center; backdrop-filter: blur(4px); z-index: 10; padding: 2rem;">
                <div style="font-size: 4.5rem; margin-bottom: 0.5rem;">🎉</div>
                <h2 style="color: #000000; margin-bottom: 0.5rem; font-size: 2.2rem; font-weight: 900;">Puzzle Complete!</h2>
                <p style="color: #475569; font-size: 1.05rem; font-weight: 600; max-width: 500px; margin-bottom: 1.5rem;">You successfully found all the hidden words generated from your profile.</p>
                <div style="display: flex; justify-content: center; gap: 1rem;">
                    <a href="/" class="btn btn-outline" style="padding: 0.6rem 1.75rem; border-radius: 50px; font-size: 0.95rem; font-weight: 800; border: 2px solid #000000; box-shadow: 2px 2px 0px #000000;">Dashboard</a>
                    <a href="/games/word_search?difficulty=<%= @difficulty %>" class="btn btn-primary" style="padding: 0.6rem 1.75rem; border-radius: 50px; font-size: 0.95rem; font-weight: 800; border: 2px solid #000000; box-shadow: 2px 2px 0px #000000;">Play Again</a>
                </div>
            </div>

        <% end %>

    </div>
  </div>
</main>

<style>
.word-search-cell {
    width: 32px;
    height: 32px;
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 1.05rem;
    font-weight: 800;
    color: #000000;
    background: #ffffff;
    border: 1.5px solid #000000;
    border-radius: 6px;
    cursor: pointer;
    transition: all 0.1s ease;
    box-shadow: 1px 1px 0px #000000;
}

.word-search-cell:hover {
    background: #ede9fe;
    transform: scale(1.08);
}

.word-search-cell.selected {
    background: #7c3aed !important;
    color: #ffffff !important;
}

.word-search-cell.found {
    background: #dcfce7 !important;
    color: #065f46 !important;
    border-color: #059669 !important;
}

.word-item {
    padding: 0.4rem 0.75rem;
    background: #f8fafc;
    border: 1.5px solid #000000;
    border-radius: 6px;
    font-size: 0.92rem;
    font-weight: 800;
    color: #000000;
    display: flex;
    align-items: center;
    justify-content: space-between;
}

.word-item.found {
    text-decoration: line-through;
    background: #dcfce7;
    color: #065f46;
    border-color: #059669;
}
</style>

<script>
    if (typeof initWordSearchPage === 'function') {
        initWordSearchPage();
    } else {
        setTimeout(() => {
            if (typeof initWordSearchPage === 'function') initWordSearchPage();
        }, 100);
    }
</script>
