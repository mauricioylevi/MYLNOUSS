<main class="app-content">
  <div style="display: flex; flex-direction: column; height: 100%; background: var(--color-bg); border-radius: 16px; overflow: hidden; box-shadow: 0 4px 20px rgba(0,0,0,0.05);">
    
    <!-- Header -->
    <div style="padding: 1.5rem 2rem; border-bottom: 1px solid var(--color-border); display: flex; justify-content: space-between; align-items: center; background: var(--color-surface);">
        <div>
            <h2 style="font-size: 1.8rem; font-weight: 700; color: var(--color-text-main); margin: 0; display: flex; align-items: center; gap: 0.5rem;">
                <span style="font-size: 2rem;">🔍</span> Word Search
            </h2>
            <p style="color: var(--color-text-muted); margin: 0.25rem 0 0 0; font-size: 0.95rem;">
                Find the words hidden in the grid! <strong style="color: var(--color-primary);">Tap the first letter, then tap the last letter</strong> to highlight a word.
            </p>
        </div>
        <div style="display: flex; gap: 1rem; align-items: center;">
            <select id="word-search-difficulty" onchange="window.location.href='/games/word_search?difficulty=' + this.value" style="padding: 0.5rem 1rem; border-radius: 50px; border: 1px solid var(--color-border); background: var(--color-bg); color: var(--color-text-main); font-size: 0.95rem; font-weight: 600; cursor: pointer; outline: none; box-shadow: var(--shadow-sm);">
                <option value="easy" <%= @difficulty == 'easy' ? 'selected' : '' %>>🟢 Easy (10x10)</option>
                <option value="medium" <%= @difficulty == 'medium' ? 'selected' : '' %>>🟡 Medium (15x15)</option>
                <option value="hard" <%= @difficulty == 'hard' ? 'selected' : '' %>>🔴 Hard (20x20)</option>
            </select>
            <a href="/" class="btn btn-outline" style="border-radius: 50px; padding: 0.4rem 1rem; font-size: 0.9rem;">&larr; Back to Dashboard</a>
        </div>
    </div>

    <!-- Game Container -->
    <div style="flex: 1; padding: 2rem; display: flex; justify-content: center; position: relative; overflow-y: auto;">
        
        <% if @words.nil? || @words.empty? %>
            <div style="text-align: center; margin-top: 4rem;">
                <h3 style="color: var(--color-text-main); font-size: 1.5rem; margin-bottom: 1rem;">Generating your puzzle...</h3>
                <p style="color: var(--color-text-muted);">We are analyzing your profile to build custom words. Please check back in a few seconds!</p>
                <div style="margin-top: 2rem; font-size: 2.5rem; animation: pulse 1.5s infinite;">⏳</div>
            </div>
            <script>
                setTimeout(() => window.location.reload(), 4000);
            </script>
        <% else %>
            <div id="word-search-container" style="max-width: 1000px; width: 100%; display: grid; grid-template-columns: 1fr 300px; gap: 2rem;" data-words="<%= @words.to_json %>" data-difficulty="<%= @difficulty %>">
                
                <!-- Grid Area -->
                <div style="display: flex; justify-content: center; align-items: flex-start;">
                    <div id="word-search-grid" style="background: var(--color-surface); padding: 1.5rem; border-radius: 16px; border: 1px solid var(--color-border); box-shadow: 0 4px 25px rgba(0,0,0,0.05); display: inline-grid; gap: 2px; user-select: none;">
                        <!-- JS injected grid cells -->
                    </div>
                </div>

                <!-- Word List Area -->
                <div style="background: var(--color-surface); padding: 1.5rem; border-radius: 16px; border: 1px solid var(--color-border); box-shadow: 0 4px 15px rgba(0,0,0,0.03); height: fit-content; max-height: 100%;">
                    <h3 style="font-size: 1.2rem; font-weight: 700; color: var(--color-text-main); margin-top: 0; margin-bottom: 1rem; border-bottom: 2px solid var(--color-bg); padding-bottom: 0.5rem;">Words to Find</h3>
                    <div id="word-search-list" style="display: flex; flex-direction: column; gap: 0.5rem; overflow-y: auto;">
                        <!-- JS injected words -->
                    </div>
                </div>

            </div>

            <!-- End Screen -->
            <div id="word-search-end-screen" style="display: none; flex-direction: column; align-items: center; text-align: center; position: absolute; inset: 0; background: rgba(255,255,255,0.9); justify-content: center; backdrop-filter: blur(5px); z-index: 10;">
                <div style="font-size: 5rem; margin-bottom: 1rem;">🎉</div>
                <h2 style="color: var(--color-text-main); margin-bottom: 0.5rem; font-size: 2.5rem;">Puzzle Complete!</h2>
                <p style="color: var(--color-text-muted); font-size: 1.1rem; max-width: 500px; margin-bottom: 2rem;">You successfully found all the hidden words generated from your profile.</p>
                <div style="display: flex; justify-content: center; gap: 1rem;">
                    <a href="/" class="btn btn-outline" style="padding: 0.75rem 2rem; border-radius: 50px; font-size: 1.1rem; background: var(--color-surface);">Return to Dashboard</a>
                    <a href="/games/word_search?difficulty=<%= @difficulty %>" class="btn btn-primary" style="padding: 0.75rem 2rem; border-radius: 50px; font-size: 1.1rem; box-shadow: 0 4px 15px rgba(99, 102, 241, 0.4);">Play Again</a>
                </div>
            </div>

        <% end %>

    </div>
  </div>
</main>

<style>
#word-search-grid {
    background: var(--color-surface);
    padding: 1.5rem;
    border-radius: 16px;
    border: 1px solid var(--color-border);
    box-shadow: 0 4px 25px rgba(0,0,0,0.05);
    display: grid;
    gap: 0; /* 0 gap with borders creates clean lines */
    user-select: none;
    width: 100%;
    max-width: 600px;
    aspect-ratio: 1 / 1;
}

.ws-cell {
    width: 100%;
    height: 100%;
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: min(1.3rem, 3.5vw);
    font-weight: 700;
    color: var(--color-text-main);
    border: 1px solid var(--color-border); /* Lines between letters */
    background: transparent;
    cursor: pointer;
    transition: background 0.1s;
}

.ws-cell:hover {
    background: rgba(99, 102, 241, 0.1);
}

.ws-cell.highlighted {
    background: rgba(99, 102, 241, 0.3);
    color: var(--color-primary-hover);
}

.ws-cell.found {
    background: rgba(16, 185, 129, 0.2);
    color: #059669;
}

.ws-word-item {
    font-size: 1.05rem;
    font-weight: 600;
    color: var(--color-text-muted);
    padding: 0.4rem 0.75rem;
    border-radius: 8px;
    background: transparent;
    border: none;
    transition: all 0.3s;
}

.ws-word-item.found {
    text-decoration: line-through;
    color: #10b981;
    background: rgba(16, 185, 129, 0.1);
}
</style>

<script>
    if (typeof initWordSearchPage === 'function') {
        initWordSearchPage();
    } else {
        setTimeout(() => {
            if (typeof initWordSearchPage === 'function') initWordSearchPage();
        }, 100);
    }
</script>
