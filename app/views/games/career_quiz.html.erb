<main class="app-content">
  <div style="display: flex; flex-direction: column; height: 100%; background: var(--color-bg); border-radius: 16px; overflow: hidden; box-shadow: 0 4px 20px rgba(0,0,0,0.05);">
    
    <!-- Header -->
    <div style="padding: 1.5rem 2rem; border-bottom: 1px solid var(--color-border); display: flex; justify-content: space-between; align-items: center; background: var(--color-surface);">
        <div>
            <h2 style="font-size: 1.8rem; font-weight: 700; color: var(--color-text-main); margin: 0; display: flex; align-items: center; gap: 0.5rem;">
                <span style="font-size: 2rem;">💼</span> Career Quiz
            </h2>
            <p style="color: var(--color-text-muted); margin: 0.25rem 0 0 0; font-size: 0.95rem;">Test your professional judgement</p>
        </div>
        <div style="display: flex; gap: 0.5rem; align-items: center;">
            <a href="/" class="btn btn-outline" style="border-radius: 50px; padding: 0.4rem 1rem; font-size: 0.9rem;">&larr; Back to Dashboard</a>
        </div>
    </div>

    <!-- Game Container -->
    <div style="flex: 1; padding: 2rem; display: flex; justify-content: center; position: relative; overflow-y: auto;">
        
        <% if @career_data.nil? %>
            <div style="text-align: center; margin-top: 4rem;">
                <h3 style="color: var(--color-text-main); font-size: 1.5rem; margin-bottom: 1rem;">Generating your scenarios...</h3>
                <p style="color: var(--color-text-muted);">We are analyzing your profile to build custom challenges. Please check back in a few seconds!</p>
                <div style="margin-top: 2rem; font-size: 2.5rem; animation: pulse 1.5s infinite;">⏳</div>
            </div>
            <script>
                setTimeout(() => window.location.reload(), 4000);
            </script>
        <% else %>
            <div id="career-quiz-container" style="max-width: 800px; width: 100%; display: flex; flex-direction: column; gap: 1rem;" data-rounds="<%= @career_data.to_json %>">
                
                <div style="display: flex; justify-content: space-between; align-items: center;">
                    <span id="career-quiz-round-counter" style="font-size: 1.1rem; font-weight: 600; color: var(--color-primary);">Scenario 1 of 3</span>
                </div>

                <div style="background: var(--color-surface); padding: 1.25rem; border-radius: 16px; border: 1px solid var(--color-border); box-shadow: 0 4px 15px rgba(0,0,0,0.03);">
                    <h3 style="font-size: 1.1rem; font-weight: 600; color: var(--color-text-muted); margin-top: 0; margin-bottom: 0.5rem; text-transform: uppercase; letter-spacing: 0.5px;">The Situation</h3>
                    <p id="career-quiz-scenario" style="font-size: 1.15rem; color: var(--color-text-main); line-height: 1.5; margin: 0;"></p>
                </div>

                <div id="career-quiz-options" style="display: flex; flex-direction: column; gap: 0.75rem;">
                    <!-- Options injected here -->
                </div>

                <div id="career-quiz-feedback" style="display: none; flex-direction: column; gap: 0.75rem; margin-top: 0.5rem;">
                    <div id="career-quiz-feedback-box" style="padding: 1rem; border-radius: 12px;">
                        <h4 id="career-quiz-feedback-title" style="margin: 0 0 0.25rem 0; font-size: 1.1rem; display: flex; align-items: center; gap: 0.5rem;"></h4>
                        <p id="career-quiz-feedback-text" style="margin: 0; font-size: 1rem; line-height: 1.4; color: var(--color-text-main);"></p>
                    </div>
                    <div style="display: flex; justify-content: flex-end;">
                        <button id="career-quiz-next-btn" class="btn btn-primary" style="padding: 0.5rem 1.5rem; border-radius: 50px; font-size: 1rem; box-shadow: 0 4px 15px rgba(99, 102, 241, 0.4);" onclick="nextCareerQuizRound()">Next Scenario &rarr;</button>
                    </div>
                </div>

            </div>

            <!-- End Screen -->
            <div id="career-quiz-end-screen" style="display: none; flex-direction: column; align-items: center; text-align: center; position: absolute; inset: 0; background: rgba(255,255,255,0.9); justify-content: center; backdrop-filter: blur(5px); z-index: 10;">
                <div style="font-size: 5rem; margin-bottom: 1rem;">🎓</div>
                <h2 style="color: var(--color-text-main); margin-bottom: 0.5rem; font-size: 2.5rem;">Quiz Complete!</h2>
                <p style="color: var(--color-text-muted); font-size: 1.1rem; max-width: 500px; margin-bottom: 2rem;">Great job applying your professional expertise to these challenging scenarios.</p>
                <div style="display: flex; justify-content: center; gap: 1rem;">
                    <a href="/" class="btn btn-outline" style="padding: 0.75rem 2rem; border-radius: 50px; font-size: 1.1rem; background: var(--color-surface);">Return to Dashboard</a>
                    <a href="/games/career_quiz" class="btn btn-primary" style="padding: 0.75rem 2rem; border-radius: 50px; font-size: 1.1rem; box-shadow: 0 4px 15px rgba(99, 102, 241, 0.4);">Play New Scenarios</a>
                </div>
            </div>

        <% end %>

    </div>
  </div>
</main>

<style>
.career-quiz-option-btn {
    width: 100%;
    text-align: left;
    padding: 1rem 1.25rem;
    background: var(--color-surface);
    border: 2px solid var(--color-border);
    border-radius: 12px;
    font-size: 1rem;
    color: var(--color-text-main);
    cursor: pointer;
    transition: all 0.2s;
    line-height: 1.3;
    display: flex;
    align-items: center;
    gap: 0.75rem;
}

.career-quiz-option-btn:hover:not(:disabled) {
    border-color: var(--color-primary);
    background: rgba(99, 102, 241, 0.05);
    transform: translateY(-2px);
}

.career-quiz-option-btn.correct {
    border-color: #10b981;
    background: rgba(16, 185, 129, 0.1);
}

.career-quiz-option-btn.incorrect {
    border-color: #ef4444;
    background: rgba(239, 68, 68, 0.1);
    opacity: 0.7;
}

.career-quiz-option-btn:disabled {
    cursor: default;
}
</style>

<script>
    if (typeof initCareerQuizPage === 'function') {
        initCareerQuizPage();
    } else {
        setTimeout(() => {
            if (typeof initCareerQuizPage === 'function') initCareerQuizPage();
        }, 100);
    }
</script>
