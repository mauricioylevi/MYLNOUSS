<main class="app-content" style="padding: 1rem 1.5rem; height: calc(100vh - 70px); box-sizing: border-box; display: flex; flex-direction: column;">
  <div style="display: flex; flex-direction: column; height: 100%; background: #ffffff; border: 2px solid #000000; border-radius: 14px; overflow: hidden; box-shadow: var(--shadow-relief-md);">
    
    <!-- Header -->
    <header style="padding: 0.65rem 1.5rem; border-bottom: 2px solid #000000; display: flex; justify-content: space-between; align-items: center; background: #ffffff; flex-shrink: 0; gap: 1rem;">
      <div style="display: flex; align-items: center; gap: 0.75rem;">
        <span style="font-size: 1.6rem; background: #ede9fe; padding: 0.2rem 0.45rem; border-radius: 8px; border: 1.5px solid #000000; box-shadow: 1.5px 1.5px 0px #000000;">💼</span>
        <div>
          <h2 style="font-size: 1.35rem; font-weight: 900; color: #000000; margin: 0; line-height: 1.2;">
            Career Quiz
          </h2>
          <span style="color: var(--color-text-muted); font-size: 0.8rem; font-weight: 600;">
            Test and exercise your professional judgement
          </span>
        </div>
      </div>
      <div style="display: flex; gap: 0.5rem; align-items: center;">
        <a href="/" class="btn btn-outline btn-compact" style="border-radius: 50px; font-weight: 700; border: 1.5px solid #000000;">
          &larr; Exit
        </a>
      </div>
    </header>

    <!-- Game Container (Top Aligned) -->
    <div style="flex: 1; padding: 1.25rem 1.5rem; display: flex; flex-direction: column; align-items: center; justify-content: flex-start; position: relative; overflow-y: auto;">
        
        <% if @career_data.nil? %>
            <div style="text-align: center; margin-top: 2rem;">
                <h3 style="color: var(--color-text-main); font-size: 1.4rem; font-weight: 900; margin-bottom: 0.5rem;">Generating your scenarios...</h3>
                <p style="color: var(--color-text-muted); font-weight: 600;">Analyzing your profile to build custom challenges. Please wait a moment...</p>
                <div style="margin-top: 1.5rem; font-size: 2.5rem; animation: pulse 1.5s infinite;">⏳</div>
            </div>
            <script>
                setTimeout(() => window.location.reload(), 3000);
            </script>
        <% else %>
            <div id="career-quiz-container" style="max-width: 800px; width: 100%; display: flex; flex-direction: column; gap: 1rem;" data-rounds="<%= @career_data.to_json %>">
                
                <div style="display: flex; justify-content: space-between; align-items: center;">
                    <span id="career-quiz-round-counter" style="font-size: 1rem; font-weight: 800; color: #5b21b6; background: #ede9fe; border: 1px solid #000000; padding: 0.2rem 0.75rem; border-radius: 50px;">Scenario 1 of 3</span>
                </div>

                <div style="background: #f8fafc; padding: 1.25rem; border-radius: 12px; border: 2px solid #000000; box-shadow: 2px 2px 0px #000000;">
                    <h3 style="font-size: 0.85rem; font-weight: 800; color: #64748b; margin-top: 0; margin-bottom: 0.4rem; text-transform: uppercase; letter-spacing: 0.5px;">The Situation</h3>
                    <p id="career-quiz-scenario" style="font-size: 1.1rem; color: #000000; font-weight: 700; line-height: 1.5; margin: 0;"></p>
                </div>

                <div id="career-quiz-options" style="display: flex; flex-direction: column; gap: 0.75rem;">
                    <!-- Options injected here -->
                </div>

                <div id="career-quiz-feedback" style="display: none; flex-direction: column; gap: 0.75rem; margin-top: 0.5rem;">
                    <div id="career-quiz-feedback-box" style="padding: 1rem; border-radius: 10px; border: 2px solid #000000; box-shadow: 2px 2px 0px #000000;">
                        <h4 id="career-quiz-feedback-title" style="margin: 0 0 0.25rem 0; font-size: 1.05rem; font-weight: 900; display: flex; align-items: center; gap: 0.5rem;"></h4>
                        <p id="career-quiz-feedback-text" style="margin: 0; font-size: 0.95rem; font-weight: 600; line-height: 1.4; color: #000000;"></p>
                    </div>
                    <div style="display: flex; justify-content: flex-end;">
                        <button id="career-quiz-next-btn" class="btn btn-primary" style="padding: 0.5rem 1.5rem; border-radius: 50px; font-size: 0.95rem; font-weight: 800; border: 2px solid #000000; box-shadow: 2px 2px 0px #000000;" onclick="nextCareerQuizRound()">Next Scenario &rarr;</button>
                    </div>
                </div>

            </div>

            <!-- End Screen -->
            <div id="career-quiz-end-screen" style="display: none; flex-direction: column; align-items: center; text-align: center; position: absolute; inset: 0; background: rgba(255,255,255,0.95); justify-content: center; backdrop-filter: blur(4px); z-index: 10; padding: 2rem;">
                <div style="font-size: 4rem; margin-bottom: 0.75rem;">🎓</div>
                <h2 style="color: #000000; margin-bottom: 0.5rem; font-size: 2.2rem; font-weight: 900;">Quiz Complete!</h2>
                <p style="color: #475569; font-size: 1.05rem; font-weight: 600; max-width: 500px; margin-bottom: 1.5rem;">Great job applying your professional expertise to these challenging scenarios.</p>
                <div style="display: flex; justify-content: center; gap: 1rem;">
                    <a href="/" class="btn btn-outline" style="padding: 0.6rem 1.75rem; border-radius: 50px; font-size: 0.95rem; font-weight: 800; border: 2px solid #000000; box-shadow: 2px 2px 0px #000000;">Return to Dashboard</a>
                    <a href="/games/career_quiz" class="btn btn-primary" style="padding: 0.6rem 1.75rem; border-radius: 50px; font-size: 0.95rem; font-weight: 800; border: 2px solid #000000; box-shadow: 2px 2px 0px #000000;">Play New Scenarios</a>
                </div>
            </div>

        <% end %>

    </div>
  </div>
</main>

<style>
.career-quiz-option-btn {
    width: 100%;
    text-align: left;
    padding: 0.85rem 1.15rem;
    background: #ffffff;
    border: 2px solid #000000;
    border-radius: 10px;
    font-size: 0.98rem;
    font-weight: 700;
    color: #000000;
    cursor: pointer;
    transition: all 0.15s;
    line-height: 1.35;
    display: flex;
    align-items: center;
    gap: 0.75rem;
    box-shadow: 2px 2px 0px #000000;
}

.career-quiz-option-btn:hover:not(:disabled) {
    background: #ede9fe;
    transform: translateY(-1px);
    box-shadow: 3px 3px 0px #000000;
}

.career-quiz-option-btn.correct {
    border-color: #000000;
    background: #dcfce7 !important;
    color: #065f46;
}

.career-quiz-option-btn.incorrect {
    border-color: #000000;
    background: #fee2e2 !important;
    color: #991b1b;
}

.career-quiz-option-btn:disabled {
    cursor: default;
}
</style>

<script>
    if (typeof initCareerQuizPage === 'function') {
        initCareerQuizPage();
    } else {
        setTimeout(() => {
            if (typeof initCareerQuizPage === 'function') initCareerQuizPage();
        }, 100);
    }
</script>
