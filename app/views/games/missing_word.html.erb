<main class="app-content">
  <div style="display: flex; flex-direction: column; height: 100%; background: var(--color-bg); border-radius: 16px; overflow: hidden; box-shadow: 0 4px 20px rgba(0,0,0,0.05);">
    
    <!-- Header -->
    <div style="padding: 1.5rem 2rem; border-bottom: 1px solid var(--color-border); display: flex; justify-content: space-between; align-items: center; background: var(--color-surface);">
        <div>
            <h2 style="font-size: 1.8rem; font-weight: 700; color: var(--color-text-main); margin: 0; display: flex; align-items: center; gap: 0.5rem;">
                <span style="font-size: 2rem;">🔤</span> Missing Word
            </h2>
        </div>
        <div style="display: flex; gap: 0.5rem; align-items: center;">
            <button onclick="giveMissingWordHint()" class="btn btn-outline" id="missing-word-hint-btn" style="display:none; border-radius: 50px; padding: 0.4rem 1rem; font-size: 0.9rem;">💡 Hint</button>
            <a href="/" class="btn btn-outline" style="border-radius: 50px; padding: 0.4rem 1rem; font-size: 0.9rem;">&larr; Back to Dashboard</a>
        </div>
    </div>

    <!-- Game Container -->
    <div style="flex: 1; padding: 2rem; display: flex; justify-content: center; align-items: center; position: relative;">
        
        <!-- Loading State -->
        <div id="missing-word-loading-screen" style="display: flex; flex-direction: column; align-items: center; justify-content: center; text-align: center;">
            <div style="font-size: 3rem; animation: spin 2s linear infinite;">⌛</div>
            <h3 style="margin-top: 1.5rem; color: var(--color-text-main);">Crafting a sentence for you...</h3>
        </div>

        <!-- Game State -->
        <div id="missing-word-game-screen" style="display: none; flex-direction: column; align-items: center; max-width: 800px; text-align: center; width: 100%;">
            <h3 id="missing-word-sentence" style="font-size: 2rem; color: var(--color-text-main); line-height: 1.6; font-weight: 500; margin-bottom: 3rem;">
                <!-- Sentence injected here -->
            </h3>
            
            <div id="missing-word-inputs" style="display: flex; gap: 0.5rem; margin-bottom: 2rem; justify-content: center; flex-wrap: wrap;">
                <!-- Inputs injected here -->
            </div>
        </div>

        <!-- End State -->
        <div id="missing-word-end-screen" style="display: none; flex-direction: column; align-items: center; text-align: center;">
            <div style="font-size: 5rem; margin-bottom: 1rem;">🎉</div>
            <h2 style="color: var(--color-text-main); margin-bottom: 0.5rem; font-size: 2.5rem;">Fantastic!</h2>
            <p style="font-size: 1.2rem; color: var(--color-text-muted); margin-bottom: 2rem;">You completed the sentence perfectly.</p>
            <div style="display: flex; justify-content: center; gap: 1rem;">
                <a href="/" class="btn btn-outline" style="padding: 0.75rem 2rem; border-radius: 50px; font-size: 1.1rem;">Exit</a>
                <button class="btn btn-primary" style="padding: 0.75rem 2rem; border-radius: 50px; font-size: 1.1rem; box-shadow: 0 4px 15px rgba(99, 102, 241, 0.4);" onclick="initMissingWordPage()">Play Again</button>
            </div>
        </div>

    </div>
  </div>
</main>

<script>
    if (typeof initMissingWordPage === 'function') {
        initMissingWordPage();
    } else {
        setTimeout(() => {
            if (typeof initMissingWordPage === 'function') initMissingWordPage();
        }, 100);
    }
</script>
