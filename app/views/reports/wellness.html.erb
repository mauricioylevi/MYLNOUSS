<main class="app-content">
<div style="max-width: 1200px; margin: 0 auto; padding: 2rem 1rem; width: 100%;">
  <div style="margin-bottom: 2.5rem; text-align: center;">
    <h1 style="font-size: 2.5rem; font-weight: 800; color: var(--color-text-main); margin: 0;">Usage Report</h1>
    <p style="font-size: 1.1rem; color: var(--color-text-muted); margin: 0.5rem 0 0 0;">Accumulative performance metrics and subscription quotas.</p>
  </div>

  <!-- Consolidated Overview Cards -->
  <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(240px, 1fr)); gap: 1.5rem; margin-bottom: 3rem;">
    
    <!-- Overall Game Completion -->
    <div style="background: var(--color-surface); border-radius: 16px; padding: 1.5rem; border: 1px solid var(--color-border); box-shadow: var(--shadow-sm); display: flex; flex-direction: column; justify-content: center; text-align: center;">
      <h3 style="color: var(--color-text-muted); font-size: 1.1rem; margin-top: 0; margin-bottom: 1rem;">Game Completion</h3>
      <div style="font-size: 3rem; font-weight: 900; color: var(--color-primary); line-height: 1; margin-bottom: 1rem;">
        <%= @completion_rate %>%
      </div>
      <p style="color: var(--color-text-muted); font-size: 0.9rem; margin: 0;">
        <strong><%= @total_started %></strong> Started &bull; <strong><%= @total_completed %></strong> Finished<br><strong><%= @total_abandoned %></strong> Abandoned
      </p>
    </div>

    <!-- Journal Consistency -->
    <div style="background: var(--color-surface); border-radius: 16px; padding: 1.5rem; border: 1px solid var(--color-border); box-shadow: var(--shadow-sm); display: flex; flex-direction: column; justify-content: center; text-align: center;">
      <h3 style="color: var(--color-text-muted); font-size: 1.1rem; margin-top: 0; margin-bottom: 1rem;">Journal Consistency</h3>
      <div style="font-size: 3rem; font-weight: 900; color: #8B5CF6; line-height: 1; margin-bottom: 1rem;">
        <%= @journal_consistency %>%
      </div>
      <p style="color: var(--color-text-muted); font-size: 0.9rem; margin: 0;">
        <strong><%= @total_journals %></strong> Entries over<br><strong><%= @days_since_first %></strong> Days
      </p>
    </div>

    <!-- Photo Storage Card -->
    <div style="background: var(--color-surface); border-radius: 16px; padding: 1.5rem; border: 1px solid var(--color-border); box-shadow: var(--shadow-sm); display: flex; flex-direction: column;">
      <h3 style="color: var(--color-text-main); font-size: 1.1rem; margin-top: 0; margin-bottom: 1rem; border-bottom: 2px solid var(--color-border); padding-bottom: 0.5rem; text-align: center;">
        Photo Storage
      </h3>
      
      <div style="display: flex; justify-content: space-between; align-items: baseline; margin-bottom: 1rem;">
        <span style="font-size: 2.5rem; font-weight: 900; color: var(--color-primary); line-height: 1;"><%= @total_photos %></span>
        <span style="font-size: 1rem; color: var(--color-text-muted); font-weight: 600;">/ <%= @max_photos %> Max</span>
      </div>

      <div style="display: flex; flex-direction: column; gap: 0.5rem; flex-grow: 1;">
        <div style="display: flex; justify-content: space-between; align-items: center; padding: 0.5rem; background: var(--color-bg); border-radius: 6px;">
          <span style="color: var(--color-text-main); font-weight: 600; font-size: 0.9rem;">Admin</span>
          <span style="font-size: 1rem; font-weight: 700; color: var(--color-primary);"><%= @admin_photos_count %></span>
        </div>
        <div style="display: flex; justify-content: space-between; align-items: center; padding: 0.5rem; background: var(--color-bg); border-radius: 6px;">
          <span style="color: var(--color-text-main); font-weight: 600; font-size: 0.9rem;">Guests</span>
          <span style="font-size: 1rem; font-weight: 700; color: #8B5CF6;"><%= @guest_photos_count %></span>
        </div>
        <div style="display: flex; justify-content: space-between; align-items: center; padding: 0.5rem; background: var(--color-bg); border-radius: 6px; border: 1px solid var(--color-border); margin-top: auto;">
          <span style="color: var(--color-text-muted); font-weight: 600; font-size: 0.9rem;">Remaining</span>
          <span style="font-size: 1rem; font-weight: 700; color: #10B981;"><%= @photos_remaining %></span>
        </div>
      </div>
      
      <div style="margin-top: 1rem; width: 100%; height: 6px; background: var(--color-bg); border-radius: 3px; overflow: hidden;">
        <div style="height: 100%; width: <%= [(@total_photos.to_f / @max_photos) * 100, 100].min %>%; background: var(--color-primary); border-radius: 3px;"></div>
      </div>
    </div>

    <!-- Guest Quota Card -->
    <div style="background: var(--color-surface); border-radius: 16px; padding: 1.5rem; border: 1px solid var(--color-border); box-shadow: var(--shadow-sm); display: flex; flex-direction: column;">
      <h3 style="color: var(--color-text-main); font-size: 1.1rem; margin-top: 0; margin-bottom: 1rem; border-bottom: 2px solid var(--color-border); padding-bottom: 0.5rem; text-align: center;">
        Guest Invitations
      </h3>
      
      <div style="display: flex; justify-content: space-between; align-items: baseline; margin-bottom: 1rem;">
        <span style="font-size: 2.5rem; font-weight: 900; color: #8B5CF6; line-height: 1;"><%= @total_guests %></span>
        <span style="font-size: 1rem; color: var(--color-text-muted); font-weight: 600;">/ <%= @max_guests %> Max</span>
      </div>

      <div style="display: flex; flex-direction: column; gap: 0.5rem; flex-grow: 1;">
        <div style="display: flex; justify-content: space-between; align-items: center; padding: 0.5rem; background: var(--color-bg); border-radius: 6px;">
          <span style="color: var(--color-text-main); font-weight: 600; font-size: 0.9rem;">Invited</span>
          <span style="font-size: 1rem; font-weight: 700; color: #8B5CF6;"><%= @total_guests %></span>
        </div>
        <div style="display: flex; justify-content: space-between; align-items: center; padding: 0.5rem; background: var(--color-bg); border-radius: 6px; border: 1px solid var(--color-border); margin-top: auto;">
          <span style="color: var(--color-text-muted); font-weight: 600; font-size: 0.9rem;">Remaining</span>
          <span style="font-size: 1rem; font-weight: 700; color: #10B981;"><%= @guests_remaining %></span>
        </div>
      </div>

      <div style="margin-top: 1rem; width: 100%; height: 6px; background: var(--color-bg); border-radius: 3px; overflow: hidden;">
        <div style="height: 100%; width: <%= [(@total_guests.to_f / @max_guests) * 100, 100].min %>%; background: #8B5CF6; border-radius: 3px;"></div>
      </div>
    </div>

  </div>

  <!-- Detailed Game Breakdown -->
  <div style="background: var(--color-surface); border-radius: 16px; border: 1px solid var(--color-border); box-shadow: var(--shadow-sm); padding: 2rem;">
    <h2 style="font-size: 1.5rem; color: var(--color-text-main); margin-top: 0; margin-bottom: 1.5rem; border-bottom: 2px solid var(--color-border); padding-bottom: 0.75rem;">
      Game Preferences & Performance
    </h2>
    
    <% if @game_stats.empty? %>
      <p style="color: var(--color-text-muted); text-align: center; padding: 2rem 0; font-size: 1.1rem;">No games have been played yet.</p>
    <% else %>
      <div style="display: flex; flex-direction: column; gap: 1rem;">
        <% @game_stats.each do |stat| %>
          <div style="display: flex; align-items: center; justify-content: space-between; padding: 1.25rem; background: var(--color-bg); border-radius: 12px; border: 1px solid var(--color-border);">
            
            <!-- Game Name -->
            <div style="flex: 2;">
              <h3 style="margin: 0; font-size: 1.25rem; color: var(--color-text-main);"><%= stat[:name] %></h3>
            </div>
            
            <!-- Stats -->
            <div style="flex: 3; display: flex; justify-content: space-around; text-align: center;">
              <div>
                <span style="display: block; font-size: 0.85rem; color: var(--color-text-muted); text-transform: uppercase; font-weight: 700;">Started</span>
                <span style="font-size: 1.2rem; font-weight: 600; color: var(--color-text-main);"><%= stat[:started] %></span>
              </div>
              <div>
                <span style="display: block; font-size: 0.85rem; color: var(--color-text-muted); text-transform: uppercase; font-weight: 700;">Finished</span>
                <span style="font-size: 1.2rem; font-weight: 600; color: #10B981;"><%= stat[:completed] %></span>
              </div>
              <div>
                <span style="display: block; font-size: 0.85rem; color: var(--color-text-muted); text-transform: uppercase; font-weight: 700;">Abandoned</span>
                <span style="font-size: 1.2rem; font-weight: 600; color: #F43F5E;"><%= stat[:abandoned] %></span>
              </div>
            </div>

            <!-- Completion Rate -->
            <div style="flex: 1; text-align: right;">
              <span style="display: block; font-size: 0.85rem; color: var(--color-text-muted); text-transform: uppercase; font-weight: 700;">Completion</span>
              <span style="font-size: 1.5rem; font-weight: 800; color: var(--color-primary);"><%= stat[:rate] %>%</span>
            </div>
          </div>
        <% end %>
      </div>
    <% end %>
  </div>

</div>
</main>
