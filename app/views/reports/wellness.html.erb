<main class="app-content">
<div style="max-width: 1200px; margin: 0 auto; padding: 2rem 1rem; width: 100%;">
  
  <!-- Header -->
  <div style="margin-bottom: 2.5rem; display: flex; justify-content: space-between; align-items: center; flex-wrap: wrap; gap: 1rem;">
    <div style="display: flex; align-items: center; gap: 0.75rem;">
      <span style="font-size: 2.2rem; background: #ccfbf1; padding: 0.4rem 0.6rem; border-radius: 12px; border: 2px solid #000000; box-shadow: 2px 2px 0px #000000;">📊</span>
      <div>
        <h1 style="font-size: 2.2rem; font-weight: 900; color: #000000; margin: 0; letter-spacing: -0.5px;">Activity &amp; Wellness Report</h1>
        <p style="font-size: 1.05rem; color: var(--color-text-muted); margin: 0.25rem 0 0 0; font-weight: 600;">
          Accumulative performance metrics, cognitive game completion &amp; journal consistency
        </p>
      </div>
    </div>
    <a href="/" class="btn btn-outline" style="border-radius: 50px; font-weight: 700; padding: 0.5rem 1.25rem; font-size: 0.9rem; border: 2px solid #000000; box-shadow: 2px 2px 0px #000000;">
      &larr; Back to Dashboard
    </a>
  </div>

  <!-- Consolidated Overview Cards -->
  <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(260px, 1fr)); gap: 1.5rem; margin-bottom: 2.5rem;">
    
    <!-- Overall Game Completion Card -->
    <div style="background: #ffffff; border-radius: 14px; padding: 1.75rem; border: 2px solid #000000; box-shadow: var(--shadow-relief-md); display: flex; flex-direction: column; justify-content: center; text-align: center;">
      <h3 style="color: #475569; font-size: 1.1rem; font-weight: 800; margin-top: 0; margin-bottom: 0.75rem;">Game Completion</h3>
      <div style="font-size: 3.5rem; font-weight: 900; color: #0f766e; line-height: 1; margin-bottom: 0.75rem;">
        <%= @completion_rate %>%
      </div>
      <p style="color: #64748b; font-size: 0.95rem; font-weight: 600; margin: 0;">
        <strong><%= @total_started %></strong> Started &bull; <strong><%= @total_completed %></strong> Finished<br><strong><%= @total_abandoned %></strong> Incomplete
      </p>
    </div>

    <!-- Journal Consistency Card -->
    <div style="background: #ffffff; border-radius: 14px; padding: 1.75rem; border: 2px solid #000000; box-shadow: var(--shadow-relief-md); display: flex; flex-direction: column; justify-content: center; text-align: center;">
      <h3 style="color: #475569; font-size: 1.1rem; font-weight: 800; margin-top: 0; margin-bottom: 0.75rem;">Journal Consistency</h3>
      <div style="font-size: 3.5rem; font-weight: 900; color: #2563eb; line-height: 1; margin-bottom: 0.75rem;">
        <%= @journal_consistency %>%
      </div>
      <p style="color: #64748b; font-size: 0.95rem; font-weight: 600; margin: 0;">
        <strong><%= @total_journals %></strong> Entries recorded over<br><strong><%= @days_since_first %></strong> Active Days
      </p>
    </div>

    <!-- Photo Storage Card -->
    <div style="background: #ffffff; border-radius: 14px; padding: 1.75rem; border: 2px solid #000000; box-shadow: var(--shadow-relief-md); display: flex; flex-direction: column;">
      <h3 style="color: #000000; font-size: 1.1rem; font-weight: 900; margin-top: 0; margin-bottom: 1rem; border-bottom: 2px solid #f1f5f9; padding-bottom: 0.5rem; text-align: center;">
        Photo Album Storage
      </h3>
      
      <div style="display: flex; justify-content: space-between; align-items: baseline; margin-bottom: 1rem;">
        <span style="font-size: 2.8rem; font-weight: 900; color: #059669; line-height: 1;"><%= @total_photos %></span>
        <span style="font-size: 1rem; color: #64748b; font-weight: 800;">/ <%= @max_photos %> Max</span>
      </div>

      <div style="display: flex; flex-direction: column; gap: 0.5rem; flex-grow: 1;">
        <div style="display: flex; justify-content: space-between; align-items: center; padding: 0.6rem 0.75rem; background: #f8fafc; border: 1.5px solid #000000; border-radius: 8px;">
          <span style="color: #000000; font-weight: 800; font-size: 0.9rem;">Admin Uploads</span>
          <span style="font-size: 0.95rem; font-weight: 800; color: #059669;"><%= @admin_photos_count %></span>
        </div>
        <div style="display: flex; justify-content: space-between; align-items: center; padding: 0.6rem 0.75rem; background: #f8fafc; border: 1.5px solid #000000; border-radius: 8px;">
          <span style="color: #000000; font-weight: 800; font-size: 0.9rem;">Guest Uploads</span>
          <span style="font-size: 0.95rem; font-weight: 800; color: #7c3aed;"><%= @guest_photos_count %></span>
        </div>
        <div style="display: flex; justify-content: space-between; align-items: center; padding: 0.6rem 0.75rem; background: #f8fafc; border: 1.5px solid #000000; border-radius: 8px; margin-top: auto;">
          <span style="color: #64748b; font-weight: 800; font-size: 0.9rem;">Slots Remaining</span>
          <span style="font-size: 0.95rem; font-weight: 800; color: #059669;"><%= @photos_remaining %></span>
        </div>
      </div>
      
      <div style="margin-top: 1rem; width: 100%; height: 8px; background: #e2e8f0; border-radius: 4px; overflow: hidden; border: 1px solid #000000;">
        <div style="height: 100%; width: <%= [(@total_photos.to_f / @max_photos) * 100, 100].min %>%; background: #059669; border-radius: 4px;"></div>
      </div>
    </div>
    
  </div>

  <!-- Detailed Game Breakdown Card -->
  <div style="background: #ffffff; border-radius: 14px; padding: 2rem; border: 2px solid #000000; box-shadow: var(--shadow-relief-md); margin-bottom: 2rem;">
    <h3 style="margin-top: 0; font-size: 1.35rem; color: #000000; font-weight: 900; margin-bottom: 1.5rem; border-bottom: 2px solid #f1f5f9; padding-bottom: 0.75rem;">
      🎮 Cognitive Game Participation Breakdown
    </h3>
    
    <% if @game_stats.empty? %>
      <div style="text-align: center; color: #64748b; padding: 3rem 1rem; background: #f8fafc; border: 2px dashed #cbd5e1; border-radius: 10px;">
        <span style="font-size: 2.5rem; display: block; margin-bottom: 0.5rem;">🧩</span>
        <p style="margin: 0; font-weight: 700; font-size: 1rem; color: #000000;">No game sessions recorded yet.</p>
        <p style="margin: 0.25rem 0 0 0; font-size: 0.88rem;">Play any cognitive activity from the "Choose a Game" menu to begin tracking insights.</p>
      </div>
    <% else %>
      <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(280px, 1fr)); gap: 1.5rem;">
        <% @game_stats.each do |stat| %>
          <div style="background: #f8fafc; border: 2px solid #000000; border-radius: 10px; padding: 1.25rem; box-shadow: 2px 2px 0px #000000;">
            <h4 style="margin: 0 0 0.75rem 0; font-size: 1.15rem; font-weight: 900; color: #000000; text-transform: capitalize;">
              <%= stat[:name].to_s.titleize %>
            </h4>
            <div style="display: flex; justify-content: space-between; font-size: 0.9rem; margin-bottom: 0.4rem; color: #475569; font-weight: 600;">
              <span>Total Started:</span>
              <strong style="color: #000000;"><%= stat[:started] %></strong>
            </div>
            <div style="display: flex; justify-content: space-between; font-size: 0.9rem; margin-bottom: 0.4rem; color: #475569; font-weight: 600;">
              <span>Completed:</span>
              <strong style="color: #059669;"><%= stat[:completed] %></strong>
            </div>
            <div style="display: flex; justify-content: space-between; font-size: 0.9rem; color: #475569; font-weight: 600;">
              <span>Completion Rate:</span>
              <strong style="color: #7c3aed;"><%= stat[:rate] %>%</strong>
            </div>
          </div>
        <% end %>
      </div>
    <% end %>
  </div>

</div>
</main>
