<main class="app-content">
<div style="max-width: 1200px; margin: 0 auto; padding: 2rem 1rem; width: 100%;">
  
  <!-- Header -->
  <div style="margin-bottom: 2.5rem; display: flex; justify-content: space-between; align-items: center; flex-wrap: wrap; gap: 1rem;">
    <div style="display: flex; align-items: center; gap: 0.75rem;">
      <span style="font-size: 2.2rem; background: #ccfbf1; padding: 0.4rem 0.6rem; border-radius: 12px; border: 2px solid #000000; box-shadow: 2px 2px 0px #000000;">🔐</span>
      <div>
        <h1 style="font-size: 2.2rem; font-weight: 900; color: #000000; margin: 0; letter-spacing: -0.5px;">Safety &amp; Access Log</h1>
        <p style="font-size: 1.05rem; color: var(--color-text-muted); margin: 0.25rem 0 0 0; font-weight: 600;">
          System login audits and access counts for all users
        </p>
      </div>
    </div>
    <a href="/" class="btn btn-outline" style="border-radius: 50px; font-weight: 700; padding: 0.5rem 1.25rem; font-size: 0.9rem; border: 2px solid #000000; box-shadow: 2px 2px 0px #000000;">
      &larr; Back to Dashboard
    </a>
  </div>

  <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(400px, 1fr)); gap: 2rem;">
    
    <!-- Today's Logins Card -->
    <div style="background: #ffffff; border-radius: 14px; padding: 2rem; border: 2px solid #000000; box-shadow: var(--shadow-relief-md);">
      <div style="display: flex; align-items: center; gap: 0.6rem; margin-bottom: 1.25rem; border-bottom: 2px solid #f1f5f9; padding-bottom: 0.75rem;">
        <span style="font-size: 1.3rem;">☀️</span>
        <h3 style="margin: 0; font-size: 1.3rem; color: #000000; font-weight: 900;">Today's Logins</h3>
      </div>
      
      <% if @log_data.sum { |d| d[:today] } == 0 %>
        <div style="text-align: center; color: #64748b; padding: 3rem 1rem; background: #f8fafc; border: 2px dashed #cbd5e1; border-radius: 10px;">
          <p style="margin: 0; font-weight: 700; font-size: 1rem; color: #000000;">No logins recorded today.</p>
        </div>
      <% else %>
        <div style="display: flex; flex-direction: column; gap: 0.75rem;">
          <% @log_data.sort_by { |d| -d[:today] }.each do |data| %>
            <% if data[:today] > 0 %>
              <div style="display: flex; justify-content: space-between; align-items: center; padding: 1rem 1.25rem; background: #f8fafc; border-radius: 10px; border: 1.5px solid #000000; box-shadow: 2px 2px 0px #000000;">
                <div>
                  <span style="display: block; color: #000000; font-weight: 900; font-size: 1.1rem;"><%= data[:name] %></span>
                  <span style="display: block; font-size: 0.85rem; color: #64748b; font-weight: 700;"><%= data[:type] %></span>
                </div>
                <div style="font-size: 1.6rem; font-weight: 900; color: #0f766e; background: #ccfbf1; padding: 0.2rem 0.75rem; border-radius: 8px; border: 1px solid #000000;">
                  <%= data[:today] %>
                </div>
              </div>
            <% end %>
          <% end %>
        </div>
      <% end %>
    </div>

    <!-- YTD Logins Card -->
    <div style="background: #ffffff; border-radius: 14px; padding: 2rem; border: 2px solid #000000; box-shadow: var(--shadow-relief-md);">
      <div style="display: flex; align-items: center; gap: 0.6rem; margin-bottom: 1.25rem; border-bottom: 2px solid #f1f5f9; padding-bottom: 0.75rem;">
        <span style="font-size: 1.3rem;">📅</span>
        <h3 style="margin: 0; font-size: 1.3rem; color: #000000; font-weight: 900;">Year-to-Date Logins</h3>
      </div>
      
      <% if @log_data.sum { |d| d[:ytd] } == 0 %>
        <div style="text-align: center; color: #64748b; padding: 3rem 1rem; background: #f8fafc; border: 2px dashed #cbd5e1; border-radius: 10px;">
          <p style="margin: 0; font-weight: 700; font-size: 1rem; color: #000000;">No logins recorded this year.</p>
        </div>
      <% else %>
        <div style="display: flex; flex-direction: column; gap: 0.75rem;">
          <% @log_data.sort_by { |d| -d[:ytd] }.each do |data| %>
            <% if data[:ytd] > 0 %>
              <div style="display: flex; justify-content: space-between; align-items: center; padding: 1rem 1.25rem; background: #f8fafc; border-radius: 10px; border: 1.5px solid #000000; box-shadow: 2px 2px 0px #000000;">
                <div>
                  <span style="display: block; color: #000000; font-weight: 900; font-size: 1.1rem;"><%= data[:name] %></span>
                  <span style="display: block; font-size: 0.85rem; color: #64748b; font-weight: 700;"><%= data[:type] %></span>
                </div>
                <div style="font-size: 1.6rem; font-weight: 900; color: #7c3aed; background: #ede9fe; padding: 0.2rem 0.75rem; border-radius: 8px; border: 1px solid #000000;">
                  <%= data[:ytd] %>
                </div>
              </div>
            <% end %>
          <% end %>
        </div>
      <% end %>
    </div>

  </div>
</div>
</main>
