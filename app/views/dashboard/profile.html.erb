<main class="app-content">
  <div style="flex-grow: 1; display: flex; align-items: center; justify-content: center; overflow: auto; padding: 2rem; background: var(--color-bg);">
        <!-- User Profile Questionnaire Modal -->
    <div id="questionnaire-modal" style="width: 100%; max-width: 800px; background: var(--color-surface); border-radius: 12px; box-shadow: var(--shadow-md); position: static;">
            
            <div class="modal-header">
                <div class="modal-title" style="display: flex; justify-content: space-between; align-items: center; width: 100%;">
                    <div style="display: flex; align-items: center; gap: 0.75rem;">
                        <button onclick="window.location.href='/'" style="background: none; border: none; font-size: 1.25rem; cursor: pointer; color: var(--color-text-muted); padding: 0; display: flex; align-items: center; transition: color 0.2s;" onmouseover="this.style.color='var(--color-text-main)'" onmouseout="this.style.color='var(--color-text-muted)'" title="Back to Dashboard">
                            &larr;
                        </button>
                        <span>📋 Onboarding Main User Profile</span>
                    </div>
                    <div style="display: flex; align-items: center; gap: 1rem;">
                        <button type="button" class="btn btn-primary" style="padding: 0.5rem 1.25rem; font-size: 0.85rem; border-radius: 50px;" onclick="handleGlobalSave()">Save Profile</button>
                        <button class="close-modal-btn" onclick="window.location.href='/'">&times;</button>
                    </div>
                </div>
                <div style="margin-top: 0.5rem; font-size: 0.9rem; color: var(--color-text-muted);">
                    <span id="completion-status">Step <span id="current-step-num">1</span> of 7</span>
                </div>
                <div class="progress-bar-container">
                    <div class="progress-bar-fill" id="progress-bar-fill"></div>
                </div>
            </div>

            <div class="modal-body" id="questionnaire-body">
                
                <!-- STEP 1: Basic Information -->
                <div class="questionnaire-step active" id="step-1">
                    <h3 class="step-title">1. Basic Information</h3>
                    <p class="step-subtitle">Please verify or update the main user's basic personal details.</p>
                    
                    <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 1.5rem; margin-bottom: 1.5rem;">
                        <div>
                            <label class="input-label">First Name <span class="input-required">(Required)</span></label>
                            <input type="text" id="prof_first_name" class="text-input required-field" placeholder="e.g. John">
                        </div>
                        <div>
                            <label class="input-label">Middle Name <span class="input-optional">(Optional)</span></label>
                            <input type="text" id="prof_middle_name" class="text-input">
                        </div>
                    </div>
                    <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 1.5rem;">
                        <div>
                            <label class="input-label">Last Name <span class="input-required">(Required)</span></label>
                            <input type="text" id="prof_last_name" class="text-input required-field" placeholder="e.g. Doe">
                        </div>
                        <div>
                            <label class="input-label">Date of Birth <span class="input-required">(Required)</span></label>
                            <input type="date" id="prof_dob" class="text-input required-field">
                        </div>
                    </div>
                </div>

                <!-- STEP 2: Demographics -->
                <div class="questionnaire-step" id="step-2">
                    <h3 class="step-title">2. Basic Demographics</h3>
                    <p class="step-subtitle">Let's collect some basic personal facts to tailor the experience.</p>
                    
                    <div style="margin-bottom: 1.75rem;">
                        <label class="input-label">Main User's Sex <span class="input-required">(Required)</span></label>
                        <div class="selection-grid required-group">
                            <label class="selection-card"><input type="radio" name="sex" value="Male"><span>Male</span></label>
                            <label class="selection-card"><input type="radio" name="sex" value="Female"><span>Female</span></label>
                            <label class="selection-card"><input type="radio" name="sex" value="Other"><span>Other</span></label>
                        </div>
                    </div>
                    
                    <div style="margin-bottom: 1.75rem;">
                        <label class="input-label">Marital Status <span class="input-required">(Required)</span></label>
                        <div class="selection-grid required-group">
                            <label class="selection-card"><input type="radio" name="marital" value="Married"><span>Married</span></label>
                            <label class="selection-card"><input type="radio" name="marital" value="Single"><span>Single</span></label>
                            <label class="selection-card"><input type="radio" name="marital" value="Widowed"><span>Widowed</span></label>
                            <label class="selection-card"><input type="radio" name="marital" value="Divorced"><span>Divorced</span></label>
                        </div>
                    </div>
                    
                    <div>
                        <label class="input-label">Current Living Arrangement <span class="input-required">(Required)</span></label>
                        <div class="selection-grid required-group">
                            <label class="selection-card"><input type="radio" name="living" value="Own home"><span>Own home</span></label>
                            <label class="selection-card"><input type="radio" name="living" value="With family"><span>With family</span></label>
                            <label class="selection-card"><input type="radio" name="living" value="Assisted living"><span>Assisted living</span></label>
                            <label class="selection-card"><input type="radio" name="living" value="Nursing facility"><span>Nursing facility</span></label>
                        </div>
                    </div>
                </div>

                <!-- STEP 3: Support System -->
                <div class="questionnaire-step" id="step-3">
                    <h3 class="step-title">3. Daily Support System</h3>
                    <p class="step-subtitle">Who assists the patient with their daily care routines?</p>
                    
                    <div>
                        <label class="input-label">Main support comes from <span class="input-required">(Required - select at least 1)</span></label>
                        <div class="selection-grid required-group">
                            <label class="selection-card"><input type="checkbox" name="support"><span>Spouse</span></label>
                            <label class="selection-card"><input type="checkbox" name="support"><span>Family</span></label>
                            <label class="selection-card"><input type="checkbox" name="support"><span>Children</span></label>
                            <label class="selection-card"><input type="checkbox" name="support"><span>Guest</span></label>
                            <label class="selection-card"><input type="checkbox" name="support"><span>Friends</span></label>
                            <label class="selection-card"><input type="checkbox" name="support"><span>Alone</span></label>
                        </div>
                    </div>
                </div>

                <!-- STEP 4: Hobbies & Pets -->
                <div class="questionnaire-step" id="step-4">
                    <h3 class="step-title">4. Hobbies & Pets</h3>
                    <p class="step-subtitle">Let's learn about their personal hobbies and pet companions.</p>
                    
                    <div style="margin-bottom: 2rem;">
                        <label class="input-label">Areas of Interest <span class="input-required">(Required - select at least 1)</span></label>
                        <div class="selection-grid required-group">
                            <label class="selection-card"><input type="checkbox" name="interest"><span>Music</span></label>
                            <label class="selection-card"><input type="checkbox" name="interest"><span>Sports</span></label>
                            <label class="selection-card"><input type="checkbox" name="interest"><span>Cooking</span></label>
                            <label class="selection-card"><input type="checkbox" name="interest"><span>Gardening</span></label>
                            <label class="selection-card"><input type="checkbox" name="interest"><span>Travel</span></label>
                            <label class="selection-card"><input type="checkbox" name="interest"><span>Reading</span></label>
                            <label class="selection-card"><input type="checkbox" name="interest"><span>Movies</span></label>
                            <label class="selection-card"><input type="checkbox" name="interest"><span>Art</span></label>
                            <label class="selection-card"><input type="checkbox" name="interest"><span>History</span></label>
                            <label class="selection-card"><input type="checkbox" name="interest"><span>Animals</span></label>
                        </div>
                    </div>
                    
                    <div>
                        <label class="input-label">Animals & Pets <span class="input-optional">(Optional)</span></label>
                        <input type="text" id="prof_pets" class="text-input" placeholder="e.g. Fido (Dog), Whiskers (Cat), Loves horses">
                    </div>
                </div>

                <!-- STEP 5: Career & Languages -->
                <div class="questionnaire-step" id="step-5">
                    <h3 class="step-title">5. Career & Professional Life</h3>
                    <p class="step-subtitle">Information regarding their professional background and communication skills.</p>
                    
                    <div style="margin-bottom: 1.75rem;">
                        <label class="input-label">Broad Career Field <span class="input-required">(Required)</span></label>
                        <select id="prof_career" class="text-input required-field">
                            <option value="">Select a general category...</option>
                            <option value="Healthcare & Medical">Healthcare & Medical</option>
                            <option value="Business & Finance">Business & Finance</option>
                            <option value="Education & Teaching">Education & Teaching</option>
                            <option value="Engineering & Technology">Engineering & Technology</option>
                            <option value="Arts & Design">Arts & Design</option>
                            <option value="Sales & Marketing">Sales & Marketing</option>
                            <option value="Legal & Public Service">Legal & Public Service</option>
                            <option value="Skilled Trades & Construction">Skilled Trades & Construction</option>
                            <option value="Science & Research">Science & Research</option>
                            <option value="Other">Other</option>
                        </select>
                    </div>
                    
                    <div style="margin-bottom: 1.75rem;">
                        <label class="input-label">Professional Experience & Career History <span class="input-optional">(Optional)</span></label>
                        <textarea id="prof_experience" class="text-input" rows="3" style="resize: vertical;" placeholder="Describe their past occupation, responsibilities, or memorable achievements..."></textarea>
                    </div>
                    
                    <div>
                        <label class="input-label">Languages (max 3) <span class="input-optional">(Optional)</span></label>
                        <input type="text" id="prof_languages" class="text-input" placeholder="e.g. English, Spanish, French">
                    </div>
                </div>

                <!-- STEP 6: Health & Lifestyle -->
                <div class="questionnaire-step" id="step-6">
                    <h3 class="step-title">6. Health & Physical Activities</h3>
                    <p class="step-subtitle">Exercise routines help target physical wellness stimulation.</p>
                    
                    <div style="margin-bottom: 2rem;">
                        <label class="input-label">Physical Exercise Level <span class="input-required">(Required)</span></label>
                        <div class="selection-grid required-group">
                            <label class="selection-card"><input type="radio" name="exercise" value="Intense"><span>Intense</span></label>
                            <label class="selection-card"><input type="radio" name="exercise" value="Regular"><span>Regular</span></label>
                            <label class="selection-card"><input type="radio" name="exercise" value="None"><span>None</span></label>
                        </div>
                    </div>
                    
                    <div>
                        <label class="input-label">Main Type of Exercise <span class="input-optional">(Optional)</span></label>
                        <input type="text" id="prof_exercise_type" class="text-input" placeholder="e.g. Walking, Swimming, Yoga">
                    </div>
                </div>

                <!-- STEP 7: Life & Interests Description -->
                <div class="questionnaire-step" id="step-7">
                    <h3 class="step-title">7. Life & Interests Summary <span class="input-optional">(Optional)</span></h3>
                    <p class="step-subtitle" style="margin-bottom: 1rem;">Provide a short, rich narrative of their life history, favorite memories, personality traits, and deep-seated interests.</p>
                    
                    <div style="background-color: var(--color-bg-secondary); border: 1px solid var(--color-border); padding: 1rem; border-radius: var(--radius-md); margin-bottom: 1.5rem;">
                        <strong style="font-size: 0.85rem; color: var(--color-primary-hover); text-transform: uppercase; display: block; margin-bottom: 0.5rem; letter-spacing: 0.5px;">💡 Suggested things to write about:</strong>
                        <ul style="margin: 0; padding-left: 1.2rem; color: var(--color-text-muted); font-size: 0.9rem; line-height: 1.5;">
                            <li>Where did the Patient grow up, and what are their favorite childhood memories?</li>
                            <li>What did they do for a career or occupation?</li>
                            <li>What are their main hobbies, favorite music, foods, or daily passions?</li>
                            <li>What are some key personality traits or life milestones they are most proud of?</li>
                        </ul>
                    </div>
                    
                    <div>
                        <label class="input-label">Short Life Description</label>
                        <textarea id="prof_life_desc" class="text-input" rows="5" style="resize: vertical;" placeholder="Type a rich description..."></textarea>
                    </div>
                </div>

            </div>

            <div class="modal-footer">
                <button type="button" class="btn btn-outline" id="prev-step-btn" style="border-radius: 50px; padding: 0.75rem 2rem;" onclick="handlePrevStep()">
                    Cancel
                </button>
                <button type="button" class="btn btn-primary" id="next-step-btn" style="border-radius: 50px; padding: 0.75rem 2.5rem;" onclick="changeQuestionnaireStep(1)">
                    Next Step &rarr;
                </button>
            </div>
            
        </div>

  </div>
</main>
